{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Host": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Loggly"
      },
      {
        "Name": "Console",
        "theme": "Serilog.Sinks.SystemsConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
      },
      {
        "Name": "Debug",
        "theme": "Serilog.Sinks.SystemsConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/logs/promo_services_log.text",
          "rollingInterval": "Day"
        }
      }
    ],
    "Properties": {
      "Application": "Promo.Services"
    }
  },
  "RoutingKeys": {
    "Rules": "Promo_Rules"
  },
  "RabbitMqOptions": {
    "HostName": "localhost",
    "UserName": "hrvster_local",
    "Password": "progamer777",
    "Port": 15672,
    "VirtualHost": "/"
  }
}
