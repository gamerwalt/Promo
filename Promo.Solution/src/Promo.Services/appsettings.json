{
  "ConnectionStrings": {
    "Membership": "server=localhost;user=root;password=progamer777;database=promo.membership",
    "Notification": "server=localhost;user=root;password=progamer777;database=promo.notifications",
    "Games": "server=localhost;user=root;password=progamer777;database=promo.games",
    "Fulfillment": "server=localhost;user=root;password=progamer777;database=promo.fulfillment"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Host": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Loggly"
      },
      {
        "Name": "Console",
        "theme": "Serilog.Sinks.SystemsConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
      },
      {
        "Name": "Debug",
        "theme": "Serilog.Sinks.SystemsConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/logs/promo_services_log.text",
          "rollingInterval": "Day"
        }
      }
    ],
    "Properties": {
      "Application": "Promo.Services"
    }
  }
}
