    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-hrvster.Services.Mailer-afad5021-049f-41fb-8f5f-34e1dab768c2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire" Version="1.8.17" />
