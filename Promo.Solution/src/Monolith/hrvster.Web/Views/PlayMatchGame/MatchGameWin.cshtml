@using hrvster.Web.Models.Plays;
@model GameplayWin
@{
    Layout = "";
    ViewData["Title"] = "Play Pick 3 Match Game";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/gameboard.css">
    <link rel="stylesheet" href="~/css/gameplaywin.css">
    <title>3x3 Gameboard</title>
</head>
<body>
    <div class="heading"><h1>You Won</h1></div>
    <form 
        asp-action="SignaturePlay"
        asp-controller="PlayMatchGame"
        asp-route-Uid="@Model.GameUid"
        asp-route-gameplayUid="@Model.GameplayUid">
        @Html.HiddenFor(m => m.GameUid)
        @Html.HiddenFor(m => m.GameplayUid)
        <div class="gameboard">
            @foreach(var tile in Model.Tiles)
            {
                <div 
                    class="tile @((Model.SelectedTiles.Contains(tile.Uid)) ? "matched" : "")" 
                    data-uid="@tile.Uid" 
                    style="background-image: url('@tile.ImageUrl')"></div>
            }
        </div>
    </form>
</body>
</html>