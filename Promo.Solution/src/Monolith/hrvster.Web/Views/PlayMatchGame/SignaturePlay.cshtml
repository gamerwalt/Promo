@using hrvster.Web.Models.Plays;
@model PlayMatchGame
@{
    Layout = "";
    ViewData["Title"] = "Play Pick 3 Match Game";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/gameboard.css">
    <title>3x3 Gameboard</title>
</head>
<body>
    <form 
        asp-action="SignaturePlay"
        asp-controller="PlayMatchGame"
        asp-route-Uid="@Model.GameUid"
        asp-route-Sig="@Model.Signature"
        asp-route-externalId="@Model.ExternalId"
        asp-route-screenName="@Model.ScreenName">
        <input type="text" asp-for="@Model.SelectedTiles" name="selected-tiles">
        <div class="gameboard">
            @foreach(var uid in Model.Tiles)
            {
                <div class="tile" data-uid="@uid"></div>
            }
            <div class="button-container">
                <div class="button-wrapper">
                    <button type="submit" class="btn btn-submit btn-primary btn-block">Submit</button>
                </div>
                <div class="button-wrapper">
                    <button type="button" id="reset" class="btn btn-reset">Reset</button>
                </div>
            </div>
        </div>
    </form>
    <script src="~/js/playGameboard.js"></script>
</body>
</html>