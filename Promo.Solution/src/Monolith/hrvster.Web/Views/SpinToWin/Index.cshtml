@{
	ViewData["Title"] = "Spin To Win Games";
}
<div class="card card-flush">
	<div class="card-header mt-5">
		<div class="card-title flex-column">
			<div class="fs-6 text-gray-400"></div>
		</div>
		<div class="card-toolbar my-1">
			<div class="me-6 my-1">
				<a asp-action="create" class="btn btn-sm btn-primary me-3">Create Spin To Win Game</a>
			</div>
		</div>
	</div>
	<div class="card-body pt-0">
		<div class="table-responsive">
			<table id="kt_profile_overview_table" class="table table-row-bordered table-row-dashed gy-4 align-middle fw-bold">
				<thead class="fs-7 text-gray-400 text-uppercase">
					<tr>
						<th class="min-w-250px">Name</th>
						<th class="min-w-90px"># of Spins</th>
						<th class="min-w-90px"># Winnable Prizes</th>
						<th class="min-w-90px"># Winnable Points</th>
						<th class="min-w-90px">Is Ready</th>
						<th class="min-w-100px">Start Date</th>
						<th class="min-w-100px">End Date</th>
					</tr>
				</thead>
				<tbody class="fs-7">
					
				</tbody>
			</table>
		</div>
	</div>
</div>