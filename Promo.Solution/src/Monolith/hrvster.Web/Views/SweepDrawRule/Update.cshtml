@model UpdateSweepDrawRule
@{
    ViewData["Title"] = $"Update {@Model.SweepstakeName}'s Entry Rule";
}
<div class="card card-bordered">
    <form asp-controller="SweepDrawRule"
          asp-action="Update"
          asp-route-sweepUid=@Model.SweepstakeUid
          asp-route-drawRuleUid=@Model.SweepDrawRuleUid
          asp-route-actionName=@Model.ReturnAction
          asp-route-controllerName=@Model.ReturnController
          enctype="multipart/form-data"
          class="form-horizontal form-material mx-2"
    >
        @Html.HiddenFor(m => m.SweepstakeUid)
        @Html.HiddenFor(m => m.SweepDrawRuleUid)
        @Html.HiddenFor(m => m.ReturnAction)
        @Html.HiddenFor(m => m.ReturnController)
        <div class="card-header">
            <h3 class="card-title">
                Update Sweep Draw Rule for @Model.SweepstakeName
            </h3>
        </div>
        <div class="card-body">
            <div class="fv-row mb-8 w-lg-200px">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Winner Count
                </label>
                <input type="text"
                       class="form-control form-control-solid"
                       placeholder="@Model.WinnerCount"
                       value="@Model.WinnerCount"
                       asp-for="@Model.WinnerCount" />
                <span asp-validation-for="@Model.WinnerCount"></span>
            </div>
            <div class="fv-row mb-8 w-lg-200px">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Winner Backup Count
                </label>
                <input type="text"
                       class="form-control form-control-solid"
                       placeholder="@Model.WinnerBackupCount"
                       value="@Model.WinnerBackupCount"
                       asp-for="@Model.WinnerBackupCount" />
                <span asp-validation-for="@Model.WinnerBackupCount"></span>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-lg-12">
                <button type="submit" class="btn btn-md btn-light btn-primary me-3">
                    Update
                </button>
                <a class="btn btn-light btn-default" href="javascript:history.go(-1)">Back</a>
            </div>
        </div>
    </form>
</div>