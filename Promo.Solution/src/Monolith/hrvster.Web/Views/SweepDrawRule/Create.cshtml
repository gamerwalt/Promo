@model CreateSweepDrawRule
@{
    ViewData["Title"] = $"{@Model.SweepstakeName} - Create Sweep Draw Rule";
}
<div><h1>Create Sweep Draw Rule for '@Model.SweepstakeName'</h1></div>
<hr />
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <form asp-controller="SweepDrawRule" asp-action="Create" asp-route-sweepUid=@Model.SweepstakeUid class="form-horizontal form-material mx-2">
                @Html.HiddenFor(m => m.SweepstakeId)
                @Html.HiddenFor(m => m.SweepstakeName)
                @Html.HiddenFor(m => m.SweepstakeUid)
                @Html.HiddenFor(m => m.ReturnAction)
                @Html.HiddenFor(m => m.ReturnController)
                <div class="form-group">
                    <label class="col-md-12">Winner Count</label>
                    <div class="col-md-12">
                        <input asp-for="WinnerCount" class="form-control form-control-lg" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-md-12">Winner Backup Count</label>
                    <div class="col-md-12">
                        <input asp-for="WinnerBackupCount" class="form-control form-control-lg" />
                    </div>
                </div>
                <hr />
                <div class="form-group">
                    <div class="col-md-12">
                        <button class="btn btn-lg btn-primary me-3" type="submit">Save</button>
                            <a class="btn btn-light btn-default" href="javascript:history.go(-1)">Back</a>
                    </div>
                </div>
            </form>
            </div>
        </div>
    </div>
</div>