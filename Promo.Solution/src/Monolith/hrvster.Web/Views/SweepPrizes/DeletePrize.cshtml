@model DeleteSweepPrize

@{
    ViewData["Title"] = $"Delete Prize {@Model.PrizeName} for {@Model.SweepName}";
}
<div class="card card-bordered">
    <form 
        asp-controller="SweepPrizes" 
        asp-action="DeletePrize"
        asp-route-sweepUid=@Model.SweepUid
        asp-route-campaignUid=@Model.CampaignUid
        asp-route-prizeUid=@Model.PrizeUid
        asp-route-returnAction=@Model.ReturnAction
        asp-route-returnController=@Model.ReturnController
        enctype="multipart/form-data"
        class="form-horizontal form-material mx-2"
    >
        @Html.HiddenFor(m => m.SweepName)
        @Html.HiddenFor(m => m.SweepId)
        @Html.HiddenFor(m => m.SweepUid)
        @Html.HiddenFor(m => m.PrizeUid)
        @Html.HiddenFor(m => m.ReturnAction)
        @Html.HiddenFor(m => m.ReturnController)
        <div class="card-header">
            <h3 class="card-title">Are you sure you want to delete @Model.PrizeName</h3>
        </div>
        <div class="card-body">
            <div class="d-flex flex-column flex-lg-row">
                <div class="flex-lg-row-fluid me-lg-15 order-2 order-lg-1 mb-10 mb-lg-0">
                    <div class="fv-row mb-6 w-lg-250px">
                        <label class="d-flex align-items-center fs-4 fw-semibold form-label mb-2">
                            Name
                        </label>
                        <span class="fs-5">@Model.PrizeName</span>
                    </div>
                    <div class="fv-row mb-6 w-lg-250px">
                        <label class="d-flex align-items-center fs-4 fw-semibold form-label mb-2">
                            Description
                        </label>
                        <span class="fs-5">@Model.PrizeDescription</span>
                    </div>
                    <div class="fv-row mb-6 w-lg-250px">
                        <label class="d-flex align-items-center fs-4 fw-semibold form-label mb-2">
                            Value
                        </label>
                        <span class="fs-5">@Model.MonetaryValue</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-lg-12">
               <button type="submit" class="btn btn-md btn-light btn-danger me-3">
                    Yes, Delete
                </button>
                <a class="btn btn-light btn-default" href="javascript:history.go(-1)">Back</a>
            </div>
        </div>
    </form>
</div>