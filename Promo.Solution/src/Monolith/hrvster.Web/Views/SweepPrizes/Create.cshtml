@using hrvster.Models.WebModels
@model CreateSweepPrize

@{
    ViewData["Title"] = $"Create Prize for {@Model.SweepName}";
}
<div class="card card-bordered">
    <form asp-controller="SweepPrizes"
          asp-action="Create"
          asp-route-sweepUid=@Model.SweepUid
          asp-route-campaignUid=@Model.CampaignUid
          asp-route-returnAction=@Model.ReturnAction
          asp-route-returnController=@Model.ReturnController
          enctype="multipart/form-data"
          class="form-horizontal form-material mx-2"
    >
        @Html.HiddenFor(m => m.SweepName)
        @Html.HiddenFor(m => m.SweepId)
        @Html.HiddenFor(m => m.SweepUid)
        @Html.HiddenFor(m => m.ReturnAction)
        @Html.HiddenFor(m => m.ReturnController)
        @Html.HiddenFor(m => m.Position)
        <div class="card-header">
            <h3 class="card-title">Create a prize for the sweepstakes @Model.SweepName</h3>
        </div>
        <div class="card-body">
            <div class="fv-row mb-8 w-lg-200px">
				<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
					Winner Position
				</label>
				<input type="text"
					class="form-control form-control-solid"
					placeholder="@Model.Position"
                       value="@Model.Position"
					asp-for="@Model.Position" disabled 
                />
			</div>
            <div class="fv-row mb-8">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Prize Name
                </label>
                <input type="text"
                       class="form-control form-control-solid"
                       placeholder="@Model.PrizeName"
                       value="@Model.PrizeName"
                       asp-for="@Model.PrizeName" maxlength="90" />
                <span asp-validation-for="PrizeName"></span>
            </div>
            <div class="fv-row mb-8">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Description
                </label>
                <input type="text"
                       class="form-control form-control-solid"
                       placeholder="@Model.PrizeDescription"
                       value="@Model.PrizeDescription"
                       asp-for="@Model.PrizeDescription" maxlength="4500" />
                <span asp-validation-for="PrizeDescription"></span>
            </div>
            <div class="fv-row mb-8 w-lg-200px">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Prize Value
                </label>
                <input type="text"
                       class="form-control form-control-solid"
                       placeholder="@Model.MonetaryValue"
                       value="@Model.MonetaryValue"
                       asp-for="@Model.MonetaryValue" />
                <span asp-validation-for="MonetaryValue"></span>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-lg-12">
               <button type="submit" class="btn btn-md btn-light btn-primary me-3">
                    Create Prize
                </button>
                <a class="btn btn-light btn-default" href="javascript:history.go(-1)">Back</a>
            </div>
        </div>
    </form>
</div>