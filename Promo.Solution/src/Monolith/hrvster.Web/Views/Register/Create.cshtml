@model Register
@{
    Layout = "~/Views/Shared/_AuthenticationLayout.cshtml";
    ViewData["Title"] = "Create an Account";
}
<div class="d-flex flex-column flex-root">
	<style>body { background-image: url('/assets/media/auth/bg4-dark.jpg'); }</style>
	<div class="d-flex flex-column flex-column-fluid flex-lg-row">
		<div class="d-flex flex-center w-lg-50 pt-15 pt-lg-0 px-10">
			<div class="d-flex flex-column">
				<a href="https://www.hrvster.com" class="mb-7">
					<img alt="Logo" src="~/images/hrvster_color_logo_no_background.png" height="100%" width="90%" />
				</a>
			</div>	
		</div>
		<div class="d-flex flex-center w-lg-50 p-10">
			<div class="card rounded-3 w-md-550px">
				<div class="card-body p-10 p-lg-20">
					<form class="form w-100" novalidate="novalidate" asp-controller="Register" asp-action="Create">
						<div class="text-center mb-11">
							<h1 class="text-dark fw-bolder mb-3">Create Account</h1>
						</div>
						<div class="separator separator-content my-14">
							<span class="w-200px text-gray-500 fw-semibold fs-7">Required Fields</span>
						</div>
						<div class="fv-row mb-8">
							<input type="text" placeholder="Email Address" asp-for="EmailAddress" autocomplete="off" class="form-control bg-transparent" />
                            <span asp-validation-for="EmailAddress"></span>
						</div>
                        <div class="fv-row mb-8">
							<input type="text" placeholder="Username" asp-for="UserName" autocomplete="off" class="form-control bg-transparent" />
                            <span asp-validation-for="UserName"></span>
						</div>
                        <div class="fv-row mb-8">
							<input type="text" placeholder="Phone" asp-for="PhoneNumber" autocomplete="off" class="form-control bg-transparent" />
                            <span asp-validation-for="PhoneNumber"></span>
						</div>
						<div class="fv-row mb-8">
							<input type="password" placeholder="Password" asp-for="Password" autocomplete="off" class="form-control bg-transparent" />
                            <span asp-validation-for="Password"></span>
						</div>

						<hr />

                        <div class="fv-row mb-8">
							<input type="text" placeholder="First Name" asp-for="FirstName" autocomplete="off" class="form-control bg-transparent" />
                            <span asp-validation-for="FirstName"></span>
						</div>
						<div class="fv-row mb-8">
							<input type="text" placeholder="Last Name" asp-for="LastName" autocomplete="off" class="form-control bg-transparent" />
                            <span asp-validation-for="LastName"></span>
						</div>

						<hr />

						<div class="fv-row mb-8">
							<input type="text" placeholder="Company Name" asp-for="CompanyName" autocomplete="off" class="form-control bg-transparent" />
							<span asp-validation-for="CompanyName"></span>
						</div>
						<div class="fv-row mb-8">
							<input type="text" id="SubdomainName" placeholder="Subdomain" asp-for="SubdomainName" autocomplete="off" class="form-control bg-transparent" />
							<span asp-validation-for="SubdomainName"></span>
						</div>
						<div class="fv-row mb-8">
							<label>Your URL: <span id="url-display">https://<span id="subdomain-display"></span>.hrvster.com</span></label>
						</div>

                        <div class="fv-row mb-8 url-input">
                            <div class="form-check form-check-solid form-switch fv-row">
							    <input class="form-check-input w-45px h-30px" type="checkbox" asp-for="AcceptedTerms" />
							    <label class="form-check-label" for="allowmarketing">
                                    Accept <a asp-controller="TermsAndConditions" asp-action="Index" class="link-primary">Terms and Conditions</a>
									<br />
									<span asp-validation-for="AcceptedTerms"></span>
                                </label>
						    </div>
                        </div>
						<div class="d-grid mb-10">
							<button type="submit" class="btn btn-primary">
								<span class="indicator-label">Create Account</span>
							</button>
						</div>

						<div class="text-gray-500 text-center fw-semibold fs-6">Already a member?
						<a asp-controller="Session" asp-action="SignIn" class="link-primary">Sign In</a></div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
<style>
	#url-display {
		color: blue;
		font-weight: bold;
	}
</style>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
