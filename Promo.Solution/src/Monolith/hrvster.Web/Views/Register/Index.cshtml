@model Register
@{
    ViewData["Title"] = "Create an Account";
}
<div><h1>Create An Account</h1></div>
<div class="row">
    <div class="col-lg-6">
        <form asp-controller="Register" asp-action="Create" class="form-horizontal form-material mx-2">
            <div class="card col-lg-12">
                <div class="card-body">
                    <div class="form-group">
                        <label class="col-md-12">Email</label>
                        <div class="col-md-12">
                            <input asp-for="EmailAddress" class="form-control form-control" />
                            <span asp-validation-for="EmailAddress"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-12">Username/DisplayName</label>
                        <div class="col-md-12">
                            <input asp-for="UserName" class="form-control form-control" />
                            <span asp-validation-for="UserName"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-12">Phone Number</label>
                        <div class="col-md-12">
                            <input asp-for="PhoneNumber" class="form-control form-control" />
                            <span asp-validation-for="PhoneNumber"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-12">First Name</label>
                        <div class="col-md-12">
                            <input asp-for="FirstName" class="form-control form-control" />
                            <span asp-validation-for="FirstName"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-12">Last Name</label>
                        <div class="col-md-12">
                            <input asp-for="LastName" class="form-control form-control" />
                            <span asp-validation-for="LastName"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-12">Password</label>
                        <div class="col-md-12">
                            <input type="password" asp-for="Password" class="form-control form-control" />
                            <span asp-validation-for="Password"></span>
                        </div>
                    </div>
                    <div class="form-group form-check">
                        <label class="form-check-label" asp-for="AcceptedTerms">
                            <input type="checkbox" class="form-check-input" id="AcceptTerms">
                            Accept <a asp-controller="TermsAndConditions" asp-action="Index">Sign In</a> and Conditions
                        </label>
                        <span asp-validation-for="AcceptedTerms"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <div>
                        <button class="btn btn btn-primary" type="submit">Create Account</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>