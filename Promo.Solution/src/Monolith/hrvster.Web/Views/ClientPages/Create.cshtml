@model CreateClientPages
@{
    ViewData["Title"] = "Create Client Images";
}
<div class="card card-flush">
	<form asp-action="Create" enctype="multipart/form-data" class="form-horizontal form-material mx-2">
		<div class="card-header mt-5">
			<div class="card-title flex-column">
				<div class="fs-1 text-white-400">Company Page Images</div>
			</div>
		</div>
		<div class="card-body pt-0">
			<div class="fv-row mb-8">
				<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
					Logo Image (Not more than 512px X 512px)
				</label>
				<input class="form-control" id="LogoLocation" asp-for="LogoLocation" type="file" />
				<span asp-validation-for="LogoLocation"></span>
			</div>
			<div class="fv-row mb-8">
				<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
					Header Image (490px X 60px)
				</label>
				<input class="form-control" id="HeaderLocation" asp-for="HeaderLocation" type="file" />
				<span asp-validation-for="HeaderLocation"></span>
			</div>
			<div class="fv-row mb-8">
				<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
					Footer Image (490px X 60px)
				</label>
				<input class="form-control" id="FooterLocation" asp-for="FooterLocation" type="file" />
				<span asp-validation-for="FooterLocation"></span>
			</div>
		</div>
		<div class="card-footer">
			<div class="card-toolbar">
				<button class="btn btn-large btn-md btn-light btn-primary" type="submit">Submit Images</button>
			</div>
		</div>
	</form>
</div>