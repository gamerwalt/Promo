@using hrvster.Core
@inject LinkBuilder linkBuilder

@model ViewMatchRule

@{
    ViewData["Title"] = $"Delete Rule";
}
<form asp-controller="MatchRules"
      asp-action="Delete"
      asp-route-ruleUid=@Model.DeleteMatchRule.RuleUid
      asp-route-gameUid=@Model.DeleteMatchRule.GameUid
      asp-route-actionName=@Model.ReturnAction
      asp-route-controllerName=@Model.ReturnController
      class="form-horizontal form-material mx-2">
      @Html.HiddenFor(c => c.DeleteMatchRule.GameUid)
      @Html.HiddenFor(c => c.DeleteMatchRule.RuleUid)
      @Html.HiddenFor(c => c.DeleteMatchRule.ExternalId)
      @Html.HiddenFor(c => c.DeleteMatchRule.ExternalClientType)
    <div class="card card-bordered">
        <div class="card-header">
            <h3 class="card-title">
                Delete Rule and @Model.ExternalClient Post for '@Model.GameName'
            </h3>
        </div>
        <div class="card-body">
            <p><strong>Hashtag</strong>: @Model.Hashtag</p>
            <p>
                <strong>External Id</strong>:
                @if (@Model.ExternalId == "0")
                {
                    <span>This Post is Scheduled</span>
                }
                else
                {
                    @if (Model.ExternalClient == hrvster.Models.ExternalClientType.Twitter.ToString())
                    {
                        <a href="@linkBuilder.BuildTwitterLink(Model.ExternalId, Model.DeleteMatchRule.RuleUid).Result" target="_blank">@Model.ExternalId</a>
                    }
                    else
                    {
                        <a href="@linkBuilder.BuildFacebookLink(Model.ExternalId, Model.DeleteMatchRule.RuleUid).Result" target="_blank">@Model.ExternalId</a>
                    }
                }
            </p>
        </div>
        <div class="card-footer">
            <button class="btn btn-lg btn-danger" type="submit">Delete</button>
            <a class="btn btn-lg btn-color-gray-800" asp-action="View" asp-controller="MatchGames" asp-route-uid="@Model.DeleteMatchRule.GameUid">Cancel</a>
        </div>
    </div>
</form>