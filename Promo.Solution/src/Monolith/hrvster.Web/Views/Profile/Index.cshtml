@using hrvster.Models
@model UpdateAccount
@{
	ViewData["Title"] = "My Profile";
	var currentAction = ViewContext.RouteData.Values["action"];
	var classAccountValue = "";
	var classUpdateAccountDetailsValue = "";
	if (currentAction.ToString() == "Index" || currentAction.ToString() == "UpdateAccount")
	{
		classAccountValue = "active";
		classUpdateAccountDetailsValue = "";
	}
	else if (currentAction.ToString() == "UpdateAccountDetails")
	{
		classAccountValue = "";
		classUpdateAccountDetailsValue = "active";
	}
}
<div class="card mb-5 mb-xl-10">
	<div class="card-body pt-9 pb-0">
		<div class="d-flex flex-wrap flex-sm-nowrap mb-3">
			<div class="me-7 mb-4">
				<div class="symbol symbol-100px symbol-lg-160px symbol-fixed position-relative">
					<img src="~/assets/media/avatars/blank.png" alt="image">
					<div class="position-absolute translate-middle bottom-0 start-100 mb-6 bg-success rounded-circle border border-4 border-body h-20px w-20px"></div>
				</div>
			</div>
			<div class="flex-grow-1">
				<div class="d-flex justify-content-start align-items-start flex-wrap mb-2">

					<div class="d-flex flex-column">
						<div class="d-flex align-items-center mb-1">
							<div class="fs-2 fw-bold me-3 text-primary">
								@Model.AccountDetails.Account.GetDisplayName()
							</div>
						</div>
						<div class="d-flex flex-wrap fw-semibold mb-4 fs-5 text-gray-400">
							Phone: @Model..Account.PhoneNumber
						</div>
					</div>
				</div>
				<div class="d-flex flex-wrap justify-content-start">
					<div class="d-flex flex-wrap">
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400"># of Promotions</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">
									@Model.AccountDetails.TotalPromotions
								</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400"># of Games</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">
									@Model.AccountDetails.TotalSweepstakes
								</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400"># of Entries</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">
									@Model.AccountDetails.TotalSweepEntries
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold">
			<li class="nav-item">
				<a class="nav-link text-active-primary py-5 me-6 active"
				   data-bs-toggle="tab"
				   href="#account">
					Account
				</a>
			</li>
			<li class="nav-item">
				<a class="nav-link text-active-primary py-5 me-6"
				   data-bs-toggle="tab"
				   href="#UpdateAccount">
					Update Account
				</a>
			</li>
			<li class="nav-item">
				<a class="nav-link text-active-primary py-5 me-6"
				   data-bs-toggle="tab"
				   href="#profiles">
					Profiles
				</a>
			</li>
		</ul>
	</div>
</div>
<div class="card mb-5 mb-xl-10">
	<div class="card-body">
		<div class="tab-content" id="promotionsTabContent">
			<div class="tab-pane fade show @classAccountValue" id="account" role="tabpanel">
				<form 
					asp-action="UpdateAccount"
					asp-controller="Profile"
					id="formUpdateProfile">
					<div class="card">
						<form 
							asp-action="UpdateAccount" 
							asp-controller="Profile">
						@Html.HiddenFor(x => x.EmailAddress)
						@Html.HiddenFor(x => x.PhoneNumber)
						<div class="card-body">
							<div class="fv-row mb-8">
								<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									UserName
								</label>
								<input type="text"
										class="form-control form-control-solid"
										placeholder="@Model.DisplayName"
										value="@Model.DisplayName"
										asp-for="@Model.DisplayName"
										value="@Model.DisplayName" />
								<span asp-validation-for="@Model.DisplayName"></span>
							</div>
							<div class="fv-row mb-8">
								<label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									First Name
								</label>
								<input type="text"
										class="form-control form-control-solid"
										   placeholder="@Model.FirstName"
										   value="@Model.FirstName"
										   asp-for="@Model.FirstName"
										   value="@Model.FirstName"/>
								<span asp-validation-for="@Model.FirstName"></span>
							</div>
							<div class="fv-row mb-8">
								<label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									Last Name
								</label>
								<input type="text"
										class="form-control form-control-solid"
										placeholder="@Model.LastName"
										value="@Model.LastName"
										asp-for="@Model.LastName"
										value="@Model.LastName" />
								<span asp-validation-for="@Model.LastName"></span>
							</div>
						</div>
						<div class="card-footer">
							<button type="submit" class="btn btn-lg btn-primary">Update</button>
						</div>
						</form>
					</div>
				</form>
			</div>
			<div class="tab-pane fade show @classUpdateAccountDetailsValue" id="UpdateAccount" role="tabpanel">
				<form
					asp-action="UpdateAccountDetails"
					asp-controller="Profile"
					id="formUpdateAccountDetails">
					@Html.HiddenFor(x => x.DisplayName)
					@Html.HiddenFor(x => x.FirstName)
					@Html.HiddenFor(x => x.LastName)
					<div class="card">
						<div class="card-body">
							<div class="fv-row mb-8">
								<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									Email Address
								</label>
								<input type="text"
										class="form-control form-control-solid"
										placeholder="@Model.EmailAddress"
										value="@Model.EmailAddress"
										asp-for="@Model.EmailAddress"
										value="@Model.EmailAddress" />
								<span asp-validation-for="@Model.EmailAddress"></span>
							</div>
							<div class="fv-row mb-8 w-lg-200px">
								<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									Phone
								</label>
								<input type="text"
									   class="form-control form-control-solid"
									   placeholder="@Model.PhoneNumber"
									   value="@Model.PhoneNumber"
									   asp-for="@Model.PhoneNumber"
									   value="@Model.PhoneNumber" />
								<span asp-validation-for="@Model.PhoneNumber"></span>
							</div>
						</div>
						<div class="card-footer">
							<button type="submit" class="btn btn-lg btn-primary">Update</button>
						</div>
					</div>
				</form>
			</div>
			<div class="tab-pane fade show" id="profiles" role="tabpanel">
				<div class="card mb-5 mb-xl-8">
					<div class="card-header border-0 pt-5">
						<h3 class="card-title align-items-start flex-column">
							<span class="card-label fw-bold text-dark">Your Profiles</span>
							<span class="text-muted mt-1 fw-semibold fs-7">@Model.AccountDetails.Profiles.Count() at the moment</span>
						</h3>
					</div>
					<div class="card-body pt-5">
						@foreach(var profile in Model.AccountDetails.Profiles)
						{
							<div class="d-flex flex-stack">
								<div class="symbol symbol-40px me-5">
									<img src="~/assets/media/svg/social-logos/twitter.svg" class="h-50 align-self-center" alt="Twitter Logo">
								</div>
								<div class="d-flex align-items-center flex-row-fluid flex-wrap">
									<div class="flex-grow-1 me-2">
										<span class="text-gray-800 text-hover-primary fs-6 fw-bold">@profile.ScreenName</span>
										<span class="text-muted fw-semibold d-block fs-7">@profile.Description</span>
									</div>
									<form id="unlinkProfileForm" asp-action="Unlink" asp-route-profileType=@profile.ProfileType>
										<button type="submit" class="btn btn-sm btn-danger fs-8 fw-bold">
											Unlink
										</button>
									</form>
								</div>
							</div>
							<div class="separator separator-dashed my-4"></div>
						}
					</div>
					<!--end::Body-->
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}