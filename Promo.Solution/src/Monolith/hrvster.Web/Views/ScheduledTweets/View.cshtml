@model UpdateScheduledSweepRuleTweet
@{
    ViewData["Title"] = "View Sweep Scheduled Tweet Rule";
}
<div class="card card-bordered">
    <div class="card-header">
        <h3 class="card-title">
            Scheduled Tweet for Sweepstake @Model.Rule.WatchValue
        </h3>
    </div>
    <div class="card-body">
        <div class="d-flex flex-column flex-lg-row">
            <div class="flex-lg-row-fluid me-lg-15 order-2 order-lg-1 mb-10 mb-lg-0">
				<form asp-action="Update" 
					asp-route-scheduledUid="@Model.ScheduledUid"
					asp-route-sweepUid="@Model.Sweepstake.SweepUid"
					asp-route-ruleUid="@Model.Rule.RuleUid"
					asp-route-actionName="@Model.ActionName"
					asp-route-controllerName="@Model.ControllerName"
					enctype="multipart/form-data">
					@Html.HiddenFor(x => x.ScheduledUid)
					@Html.HiddenFor(x => x.Sweepstake)
					@Html.HiddenFor(x => x.ActionName)
					@Html.HiddenFor(x => x.ControllerName)
					<input type="hidden" name="RuleId" id="RuleId" value="@Model.RuleId" />
					<div class="card">
						<div class="card-body">
							<div class="fv-row mb-8 w-lg-400px">
								<label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									Current Status
								</label>
								<label class="fs-6 fw-semibold">@Model.Status</label>
							</div>
							<div class="fv-row mb-8 w-lg-400px">
								<label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									Watch Value
								</label>
								<label class="fs-6 fw-semibold">@Model.Rule.WatchValue</label>
							</div>
							<div class="fv-row mb-8 w-lg-400px">
								<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									Scheduled Time
								</label>
								<input name="ScheduledTime" id="ScheduledTime" asp-for="ScheduledTime" class="form-control form-control-lg"
									   asp-format="{0:yyyy-MM-ddTHH:mm}" />
								<span asp-validation-for="ScheduledTime"></span>
							</div>
							<div class="fv-row mb-8">
								<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									Tweet (Max 140)
								</label>
								<textarea name="Text"
										  class="form-control form-control-lg"
										  id="Text"
										  asp-for="Text" rows="5" cols="70"></textarea>
								<span asp-validation-for="Text"></span>
							</div>
							<div class="fv-row mb-8 w-lg-500px">
								<label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									Picture 1
								</label>
								@if(Model.Images.Count >= 1 && Model.Images?[0] != null)
								{
									if(Model.Images[0].Contains(".mp4"))
									{
										<a href="@Model.Images[0]" target="_blank">Video Link</a>
									}	
									else
									{
										<img src="@Model.Images[0]" width="80px" alt="Media1" />
									}
									<input type="hidden" name="PreviousMediaId1" id="PreviousMediaId1" value="@Model.PreviousMediaId1" />
								}
								<input class="form-control"
									placeholder="Media1"
									title="Media1"
									asp-for="Media1"
									type="file" />
							</div>
							<div class="fv-row mb-8 w-lg-500px">
								<label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									Picture 2
								</label>
								@if (Model.Images.Count >= 2 && Model.Images?[1] != null)
								{
									if(Model.Images[1].Contains(".mp4"))
									{
										<a href="@Model.Images[1]" target="_blank">Video Link</a>
									}	
									else
									{
										<img src="@Model.Images[1]" width="80px" alt="Media1" />
									}
									<input type="hidden" name="PreviousMediaId2" id="PreviousMediaId2" value="@Model.PreviousMediaId2" />
								}
								<input class="form-control"
									   asp-for="Media2"
									   type="file" />
								<span asp-validation-for="Media2"></span>
							</div>
							<div class="fv-row mb-8 w-lg-500px">
								<label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									Picture 3
								</label>
								@if (Model.Images.Count >= 3 && Model.Images?[2] != null)
								{
									if (Model.Images[2].Contains(".mp4"))
									{
										<a href="@Model.Images[2]" target="_blank">Video Link</a>
									}
									else
									{
										<img src="@Model.Images[2]" width="80px" alt="Media1" />
									}
									<input type="hidden" name="PreviousMediaId3" id="PreviousMediaId3" value="@Model.PreviousMediaId3" />
								}
								<input class="form-control"
									   asp-for="Media3"
									   type="file" />
								<span asp-validation-for="Media3"></span>
							</div>
							<div class="fv-row mb-8 w-lg-500px">
								<label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
									Picture 4
								</label>
								@if (Model.Images.Count >= 4 && Model.Images?[3] != null)
								{
									if(Model.Images[3].Contains(".mp4"))
									{
										<a href="@Model.Images[3]" target="_blank">Video Link</a>
									}	
									else
									{
										<img src="@Model.Images[3]" width="80px" alt="Media1" />
									}
									<input type="hidden" name="PreviousMediaId4" id="PreviousMediaId4" value="@Model.PreviousMediaId4" />
								}
								<input class="form-control"
									   asp-for="Media4"
									   type="file" />
								<span asp-validation-for="Media4"></span>
							</div>
						</div>
						<div class="card-footer">
							<button class="btn btn-lg btn-primary me-3" type="submit">Update</button>
						</div>
					</div>
				</form>
            </div>
            <div class="flex-column flex-lg-row-auto w-100 w-lg-250px w-xl-300px mb-10 order-1 order-lg-2">
				<div class="card card-flush pt-3 mb-0" data-kt-sticky="true" data-kt-sticky-name="sweep-summary" 
                    data-kt-sticky-offset="{default: false, lg: '200px'}" 
                    data-kt-sticky-width="{lg: '250px', xl: '300px'}" data-kt-sticky-left="auto" data-kt-sticky-top="150px" 
                    data-kt-sticky-animation="false" data-kt-sticky-zindex="95">
					<div class="card-header">
						<div class="card-title">
							<h2>Sweepstake Details</h2>
						</div>
					</div>
					<div class="card-body pt-0 fs-6">
						<div class="mb-7">
							<div class="d-flex align-items-center mb-1">
								<a 
									asp-action="View" 
									asp-controller="Sweeps"
									asp-route-campaignUid="@Model.Sweepstake.SweepUid"
									class="fw-bold text-gray-800 text-hover-primary me-2">
									@Model.Sweepstake.Name
								</a>
							</div>
						</div>
						<div class="separator separator-dashed mb-7"></div>
						<div class="mb-7">
							<h5 class="mb-3">Dates</h5>
							<div class="mb-0">
								<span class="badge badge-light-info me-2 fs-6">Start Date: @Model.Sweepstake.StartDate.ToString("G")</span>
								<span class="badge badge-light-info me-2 fs-6">End Date: @Model.Sweepstake.EndDate.ToString("G")</span>
								<span class="badge badge-light-info me-2 fs-6">End Date: @Model.Sweepstake.DrawDate.GetValueOrDefault().ToString("G")</span>
							</div>
						</div>
						<div class="separator separator-dashed mb-7"></div>
						<div class="mb-10">
							<h5 class="mb-3">Rule Watch Value</h5>
							<div class="mb-0">
								<div class="fw-semibold text-gray-600 d-flex align-items-center">
									@Model.Rule.WatchValue
									@*<img src="~/assets/media/svg/card-logos/mastercard.svg" class="w-35px ms-2" alt="">*@
								</div>
							</div>
							<h5 class="mb-3">Rule Following</h5>
							<div class="mb-0">
								<div class="fw-semibold text-gray-600 d-flex align-items-center">
									@Model.Rule.MustBeFollowing
								</div>
							</div>
						</div>
						<div class="separator separator-dashed mb-7"></div>
						<div class="mb-10">
							<h5 class="mb-3">Promotion Name</h5>
							<div class="mb-0">
								<div class="fw-semibold text-gray-600 d-flex align-items-center">
									@Model.Sweepstake.Campaign.CampaignName
								</div>
							</div>
						</div>
						<div class="mb-0">
							<a class="btn btn-primary"
								asp-action="View" asp-controller="Sweeps" asp-route-campaignUid="@Model.Sweepstake.SweepUid">
								View
							</a>
						</div>
					</div>
				</div>
			</div>
        </div>
    </div>
</div>