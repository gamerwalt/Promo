@using hrvster.Models.Options;
@using hrvster.Models.Subscriptions;
@using hrvster.Models;
@inject hrvster.Models.Options.PaymentProviderOptions paymentProviderOption;
@model IEnumerable<Plan>
@{
	ViewData["Title"] = "Select a Plan";

	var paymentProvider = Enum.Parse<PaymentClient>(paymentProviderOption.PaymentProvider);
}
@if(paymentProvider == PaymentClient.Flutterwave)
{
	<div class="post d-flex flex-column-fluid" id="kt_post">
		<div id="kt_content_container" class="container-xxl">
			<div class="card" id="kt_pricing">
				<div class="card-body p-lg-17">
					<div class="d-flex flex-column">
						<div class="mb-13 text-center">
							<h1 class="fs-2hx fw-bold mb-5">Choose Your Plan</h1>
							<div class="text-success fw-semibold fs-5">
								You need to select a plan before you continue.
							</div>
						</div>
						<div class="nav-group nav-group-outline mx-auto mb-15" data-kt-buttons="true">
							<button class="btn btn-color-gray-400 btn-active btn-active-secondary px-6 py-3 me-2 active" data-kt-plan="month">
								Monthly
							</button>
						</div>
						<div class="row g-10">
							<div style="text-align: center" class="text-succes fw-bold fs-lg-1">You will not be charged for 1 month if you select Trial Mode</div>
							@foreach (var plan in Model)
							{
								<div class="col-xl-4">
									<div class="d-flex h-100 align-items-center">
										<div class="w-100 d-flex flex-column flex-center rounded-3 bg-light bg-opacity-75 py-15 px-10">
											<div class="mb-7 text-center">
												<h1 class="text-dark mb-5 fw-bolder">@plan.PlanName</h1>
												<div class="text-gray-400 fw-semibold mb-5">
													@plan.PlanDescription
												</div>
												<div class="text-center">
													<span class="mb-2 text-primary">Ngn</span>
													<span class="fs-3x fw-bold text-primary" data-kt-plan-price-month="@plan.PricePerMonth.ToString("#,##0")" data-kt-plan-price-annual="@plan.PricePerYear.ToString("#,##0")">
														@plan.PricePerMonth.ToString("#,##0")
													</span>
												</div>
											</div>
											<div class="w-100 mb-10">
												<div class="d-flex align-items-center mb-5">
													<span class="fw-semibold fs-6 text-gray-800 flex-grow-1 pe-3">
														<span class="fw-bold fs-6 text-gray-800 flex-grow-1 pe-3">
															@if (@plan.PromotionsPerMonth == 0)
															{
																<span class="fw-bold fs-7 text-gray-800 flex-grow-1 pe-3">
																	Unlimited promotions per month
																</span>
															}
															else
															{
																<span class="fw-bold fs-7 text-gray-800 flex-grow-1 pe-3">
																	@plan.PromotionsPerMonth promotions per month
																</span>
															}
														</span>
													</span>
													<span class="svg-icon svg-icon-1 svg-icon-success">
														<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
															<rect opacity="0.3" x="2" y="2" width="20" height="20" rx="10" fill="currentColor" />
															<path d="M10.4343 12.4343L8.75 10.75C8.33579 10.3358 7.66421 10.3358 7.25 10.75C6.83579 11.1642 6.83579 11.8358 7.25 12.25L10.2929 15.2929C10.6834 15.6834 11.3166 15.6834 11.7071 15.2929L17.25 9.75C17.6642 9.33579 17.6642 8.66421 17.25 8.25C16.8358 7.83579 16.1642 7.83579 15.75 8.25L11.5657 12.4343C11.2533 12.7467 10.7467 12.7467 10.4343 12.4343Z" fill="currentColor" />
														</svg>
													</span>
												</div>
												<div class="d-flex align-items-center mb-5">
													<span class="fw-semibold fs-6 text-gray-800 flex-grow-1 pe-3">
														<span class="fw-bold fs-7 text-gray-800 flex-grow-1 pe-3">
															Unlimited Sweepstakes
														</span>
													</span>
													<span class="svg-icon svg-icon-1 svg-icon-success">
														<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
															<rect opacity="0.3" x="2" y="2" width="20" height="20" rx="10" fill="currentColor" />
															<path d="M10.4343 12.4343L8.75 10.75C8.33579 10.3358 7.66421 10.3358 7.25 10.75C6.83579 11.1642 6.83579 11.8358 7.25 12.25L10.2929 15.2929C10.6834 15.6834 11.3166 15.6834 11.7071 15.2929L17.25 9.75C17.6642 9.33579 17.6642 8.66421 17.25 8.25C16.8358 7.83579 16.1642 7.83579 15.75 8.25L11.5657 12.4343C11.2533 12.7467 10.7467 12.7467 10.4343 12.4343Z" fill="currentColor" />
														</svg>
													</span>
												</div>
												<div class="d-flex align-items-center mb-5">
													@if (plan.SweepstakesMaximumEntries == 0)
													{
														<span class="fw-bold fs-7 text-gray-800 flex-grow-1 pe-3">
															Unlimited sweepstakes entries
														</span>
													}
													else
													{
														<span class="fw-semibold fs-7 text-gray-800 flex-grow-1 pe-3">
															@plan.SweepstakesMaximumEntries sweepstakes maximum entries per month
														</span>
													}
													<span class="svg-icon svg-icon-1 svg-icon-success">
														<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
															<rect opacity="0.3" x="2" y="2" width="20" height="20" rx="10" fill="currentColor" />
															<path d="M10.4343 12.4343L8.75 10.75C8.33579 10.3358 7.66421 10.3358 7.25 10.75C6.83579 11.1642 6.83579 11.8358 7.25 12.25L10.2929 15.2929C10.6834 15.6834 11.3166 15.6834 11.7071 15.2929L17.25 9.75C17.6642 9.33579 17.6642 8.66421 17.25 8.25C16.8358 7.83579 16.1642 7.83579 15.75 8.25L11.5657 12.4343C11.2533 12.7467 10.7467 12.7467 10.4343 12.4343Z" fill="currentColor" />
														</svg>
													</span>
												</div>
												<div class="d-flex align-items-center mb-5">
													<span class="fw-semibold fs-6 text-gray-800 flex-grow-1 pe-3">
														<span class="fw-bold fs-7 text-gray-800 flex-grow-1 pe-3">
															@plan.HashtagsPerMonth Hashtags/Rules per month
														</span>
													</span>
													<span class="svg-icon svg-icon-1 svg-icon-success">
														<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
															<rect opacity="0.3" x="2" y="2" width="20" height="20" rx="10" fill="currentColor" />
															<path d="M10.4343 12.4343L8.75 10.75C8.33579 10.3358 7.66421 10.3358 7.25 10.75C6.83579 11.1642 6.83579 11.8358 7.25 12.25L10.2929 15.2929C10.6834 15.6834 11.3166 15.6834 11.7071 15.2929L17.25 9.75C17.6642 9.33579 17.6642 8.66421 17.25 8.25C16.8358 7.83579 16.1642 7.83579 15.75 8.25L11.5657 12.4343C11.2533 12.7467 10.7467 12.7467 10.4343 12.4343Z" fill="currentColor" />
														</svg>
													</span>
												</div>
												<div class="d-flex align-items-center mb-5">
													<span class="fw-semibold fs-6 text-gray-400 flex-grow-1">More games to come</span>
													<span class="svg-icon svg-icon-1">
														<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
															<rect opacity="0.3" x="2" y="2" width="20" height="20" rx="10" fill="currentColor" />
															<rect x="7" y="15.3137" width="12" height="2" rx="1" transform="rotate(-45 7 15.3137)" fill="currentColor" />
															<rect x="8.41422" y="7" width="12" height="2" rx="1" transform="rotate(45 8.41422 7)" fill="currentColor" />
														</svg>
													</span>
												</div>
											</div>
											<form asp-action="SelectPlanForUser" asp-route-planUid="@plan.PlanUid">
												<button class="btn btn-sm btn-primary fw-bold fs-5" type="submit">Select</button>
											</form>
											<hr />
											<form asp-action="SelectTrialForUser" asp-route-planUid="@plan.PlanUid">
												<button class="btn btn-sm btn-info fw-bold fs-5" type="submit">Trial Mode</button>
											</form>
										</div>
									</div>
								</div>
							}
						</div>
						<div class="row g-10 my-6">
							<div class="col-xl-12">
								<div class="d-flex h-100 align-items-center">
									<div class="fw-bold fs-3 text-gray-800 flex-grow-1 pe-3 w-100 d-flex flex-column flex-center rounded-3 bg-light bg-opacity-75 py-15 px-10">
										If these plans do not fit your needs, please send us an email at <a href="mailto:admin@hrvster.com">admin@hrvster.com</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}
else if(paymentProvider == PaymentClient.Stripe)
{
	<script async src="https://js.stripe.com/v3/pricing-table.js"></script>
	<stripe-pricing-table pricing-table-id="prctbl_1OQNJoLcIFq7j95FRd7OKSa5"
						  publishable-key="pk_test_51OPnmfLcIFq7j95F1k40xyce7ZbRCrFTdBc2GTZGsEZmOQI3yLvTUIf3cLLLulnw1Ww46t2iIfpk5vB5GZ25qK3G000OII1n4H">
	</stripe-pricing-table>
}