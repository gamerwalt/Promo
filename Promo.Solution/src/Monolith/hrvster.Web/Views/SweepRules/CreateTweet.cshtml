@model CreateSweepRuleTweet
@{
    ViewData["Title"] = $"{@Model.SweepstakeName} - Create/Publish Sweep Rule Tweet";
}
<div><h4>Create/Publish Sweep Rule Tweet for @Model.SweepstakeName</h4></div>
<div>
    @Html.ValidationMessage("CustomError")
</div>
<hr />
<form 
asp-controller="SweepRules" 
asp-action="CreateTweet" 
asp-route-sweepUid=@Model.SweepstakeUid
asp-route-returnAction=@Model.ReturnAction
asp-route-returnController=@Model.ReturnController
enctype="multipart/form-data"
class="form-horizontal form-material mx-2">
    @Html.HiddenFor(m => m.SweepstakeUid)
    @Html.HiddenFor(m => m.ReturnAction)
    @Html.HiddenFor(m => m.ReturnController)
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <div class="form-group">
                    <label><strong>Watch Type:</strong></label>
                    <div class="col-md-12">
                        <select 
                        asp-for="WatchTypeId" 
                        asp-items=@Model.WatchTypes class="form-control form-control-lg">
                            <option>Please select one</option>
                        </select>
                        <span asp-validation-for="WatchTypeId"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-md-12">Watch Value:</label>
                <div class="col-md-6">
                    <input 
                        class="form-control form-control-lg" 
                        id="WatchValue" 
                        asp-for="WatchValue"/>
                    <span asp-validation-for="WatchValue"></span>
                </div>
            </div>
            <div class="form-group">
                <label class="col-md-12">Tweet:</label>
                <div class="col-md-12">
                    <textarea name="TweetText" 
                        class="form-control form-control-lg" 
                        id="TweetText" 
                        asp-for="TweetText" rows="5" cols="70"></textarea>
                    <span asp-validation-for="TweetText"></span>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <label><strong>Immediate/Schedule:</strong></label>
                    <br />
                    <label>
                        <input type="radio" asp-for="PostNow" id="PostNow" name="PostNow" checked value="True">
                        Immediate
                    </label>
                    <br />
                    <label>
                        <input type="radio" asp-for="PostNow" id="PostNow" name="PostNow" value="False" />
                        Scheduled
                    </label>
                    <div class="col-md-12" id="scheduleDiv">
                        <div class="form-group">
                            <label><strong>Date</strong></label>
                            <input asp-for="ScheduledDate" class="form-control form-control-lg" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <label><strong>Must be following?</strong></label>
                    <br />
                    <label>
                        <input type="radio" asp-for="MustBeFollowing" id="MustBeFollowing" name="MustBeFollowing" checked value="True">
                        Yes
                    </label>
                    <label>
                        <input type="radio" asp-for="MustBeFollowing" id="MustBeFollowing" name="MustBeFollowing" value="False">
                        No
                    </label>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <label><strong>Media 1</strong></label>
                    <div class="col-md-12">
                        <input 
                            class="form-control" 
                            id="Media1" 
                            asp-for="Media1"
                            type="file" />
                        <span asp-validation-for="Media1"></span>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <label><strong>Media 2</strong></label>
                    <div class="col-md-12">
                        <input 
                            class="form-control" 
                            id="Media1" 
                            asp-for="Media2"
                            type="file" />
                        <span asp-validation-for="Media2"></span>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <label><strong>Media 3</strong></label>
                    <div class="col-md-12">
                        <input 
                            class="form-control" 
                            id="Media1" 
                            asp-for="Media3"
                            type="file" />
                        <span asp-validation-for="Media3"></span>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <label><strong>Media 4</strong></label>
                    <div class="col-md-12">
                        <input 
                            class="form-control" 
                            id="Media1" 
                            asp-for="Media4"
                            type="file" />
                        <span asp-validation-for="Media4"></span>
                    </div>
                </div>
            </div>
            <hr />
            <div class="form-group">
                <div class="col-md-12">
                    <button class="btn btn-lg btn-primary" type="submit">Create</button>
                </div>
            </div>
        </div>
    </div>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
