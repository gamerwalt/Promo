@using hrvster.Core
@using hrvster.Models.WebModels.Sweeps

@inject LinkBuilder linkBuilder
@model SweepRule
@{
    ViewData["Title"] = $"{@Model.Sweepstake.Name}'s Rules";
    var entryRuleExists = @Model.EntryRule == null ? false : true;
    var entryPerUser = @Model.EntryRule == null ? 0 : @Model.EntryRule.EntryPerUser;

    var drawRuleExists = @Model.DrawRule == null ? false : true;
    var winnerCount = @Model.DrawRule == null ? 0 : @Model.DrawRule.WinnerCount;
    var winnerBackupCount = @Model.DrawRule == null ? 0 : @Model.DrawRule.WinnerBackupCount;
}
<div class="card card-bordered">
    <div class="card-header">
        <h3 class="card-title">
            Rules for Sweepstakes @Model.Sweepstake.Name
        </h3>
    </div>
    <div class="card-body">
        <div class="d-flex flex-column flex-lg-row">
            <div class="flex-lg-row-fluid me-lg-15 order-2 order-lg-1 mb-10 mb-lg-0">
                <div class="table-responsive">
                    <table class="table table-striped gy-7 gs-7">
                        <thead>
                            <tr class="fw-semibold fs-6 text-gray-800 border-bottom-2 border-gray-200">
                                <th>Watch Type</th>
                                <th>Watch Value</th>
                                <th>Tweet Link</th>
                                <th>Active</th>
                                <th>Must Be Following?</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var rule in @Model.Rules)
                            {
                                <tr>
                                    <td scope="row">
                                        @rule.WatchType.ToString()
                                    </td>
                                    <td>@rule.WatchValue</td>
                                    <td>
                                        @if(@rule.ExternalId == "0")
                                        {
                                            <a asp-action="View" asp-controller="ScheduledTweet" 
                                                asp-route-ruleUid="@rule.RuleUid"
                                                asp-route-sweepUid="@Model.Sweepstake.SweepUid">
                                                Scheduled
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@linkBuilder.BuildTwitterLink(@rule.ExternalId).Result" target="_blank">@rule.ExternalId</a>
                                        }
                                    </td>
                                    <td>
                                        @if (@rule.ActiveInd)
                                        {
                                            <span>True</span>
                                        }
                                        else
                                        {
                                            <span>False</span>
                                        }
                                    </td>
                                    <td>
                                        @if(@rule.MustBeFollowing)
                                        {
                                            <span>True</span>
                                        }
                                        else
                                        {
                                            <span>False</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="me-0">
                                            <button class="btn btn-sm btn-bg-light btn-active-color-primary"
                                                data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
                                                <div>Actions</div>
                                            </button>
                                            <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
                                                <div class="menu-item px-3">
                                                    <div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase">
                                                        Rule Actions
                                                    </div>
                                                </div>
                                                <div class="menu-item px-3">
                                                    <a asp-action="Update" asp-controller="SweepRules"
                                                        asp-route-sweepUid="@rule.RuleUid" class="menu-link px-3">
                                                        Edit
                                                    </a>
                                                </div>
                                                @if(rule.ExternalId != "0")
                                                {
                                                    <div class="menu-item px-3">
                                                        <a 
                                                            asp-action="Delte" 
                                                            asp-controller="SweepRules"
                                                            asp-route-sweepUid="@Model.Sweepstake.SweepUid"
                                                            asp-route-ruleUid="@rule.RuleUid"
                                                            asp-route-actionName=@ViewContext.RouteData.Values["action"]
                                                            asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
                                                            class="menu-link flex-stack px-3">
                                                            Delete
                                                        </a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="menu-item px-3">
                                                        <a 
                                                            asp-action="DelteScheduledRule" 
                                                            asp-controller="SweepRules"
                                                            asp-route-sweepUid="@Model.Sweepstake.SweepUid"
                                                            asp-route-ruleUid="@rule.RuleUid"
                                                            asp-route-actionName=@ViewContext.RouteData.Values["action"]
                                                            asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
                                                            class="menu-link flex-stack px-3">
                                                            Delete Scheduled
                                                        </a>
                                                    </div>
                                                }
                                                @if(rule.ActiveInd)
                                                {
                                                    <div class="menu-item px-3">
                                                        <a 
                                                            asp-action="Deactivate" 
                                                            asp-controller="SweepRules"
                                                                asp-route-sweepUid="@rule.RuleUid" 
                                                                class="menu-link flex-stack px-3">
                                                            Deactivate
                                                        </a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="menu-item px-3">
                                                        <a asp-action="Activate" asp-controller="SweepRules"
                                                        asp-route-sweepUid="@rule.RuleUid" class="menu-link flex-stack px-3">
                                                            Activate
                                                        </a>
                                                    </div>
                                                }
                                            </div
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="flex-column flex-lg-row-auto w-100 w-lg-250px w-xl-300px mb-10 order-1 order-lg-2">
				<div class="card card-flush pt-3 mb-0" data-kt-sticky="true" data-kt-sticky-name="sweep-summary" 
                    data-kt-sticky-offset="{default: false, lg: '200px'}" 
                    data-kt-sticky-width="{lg: '250px', xl: '300px'}" data-kt-sticky-left="auto" data-kt-sticky-top="150px" 
                    data-kt-sticky-animation="false" data-kt-sticky-zindex="95">
					<div class="card-header">
						<div class="card-title">
							<h2>Sweepstake Details</h2>
						</div>
					</div>
					<div class="card-body pt-0 fs-6">
						<div class="mb-7">
							<div class="d-flex align-items-center mb-1">
								<a 
									asp-action="View" 
									asp-controller="Sweeps"
									asp-route-campaignUid="@Model.Sweepstake.SweepUid"
									class="fw-bold text-gray-800 text-hover-primary me-2">
									@Model.Sweepstake.Name
								</a>
							</div>
						</div>
						<div class="separator separator-dashed mb-7"></div>
						<div class="mb-7">
							<h5 class="mb-3">Dates</h5>
							<div class="mb-0">
								<span class="badge badge-light-info me-2">Start Date: @Model.Sweepstake.StartDate.ToString("f")</span>
								<span class="badge badge-light-info me-2">End Date: @Model.Sweepstake.EndDate.ToString("f")</span>
                                <span class="badge badge-light-info me-2">End Date: @Model.Sweepstake.DrawDate.GetValueOrDefault().ToString("f")</span>
							</div>
						</div>
						<div class="separator separator-dashed mb-7"></div>
						<div class="mb-10">
							<h5 class="mb-3">Promotion</h5>
							<div class="mb-0">
								<div class="fw-semibold text-gray-600 d-flex align-items-center">
									@Model.Sweepstake.Campaign.CampaignName
									@*<img src="~/assets/media/svg/card-logos/mastercard.svg" class="w-35px ms-2" alt="">*@
								</div>
							</div>
						</div>
						<div class="mb-0">
							<a class="btn btn-primary"
								asp-action="View" asp-controller="Sweeps" asp-route-campaignUid="@Model.Sweepstake.SweepUid">
								Update
							</a>
						</div>
					</div>
				</div>
			</div>
        </div>
    </div>
</div>
<div class="row col-md-12">
    <div class="card col-md-12">
        <div class="card-header">
            <h4>Rules for Sweepstakes @Model.Sweepstake.Name</h4>
        </div>
        <div class="card-body">
            <h5 class="card-title"><span class="font-weight-lighter">Runs from</span> <span class="font-italic">@Model.Sweepstake.StartDate</span> <span class="font-weight-lighter">to</span> <span class="font-italic">@Model.Sweepstake.EndDate</span> <span class="font-weight-lighter">| Draw Date</span>: <span class="font-italic">@Model.Sweepstake.DrawDate</span></h5>
            <hr />
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    <div class="card">
                        <div class="card-header">Rules and Watch Values</div>
                        <div class="card-body">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th scope="col">Watch Type</th>
                                        <th scope="col">Watch Value</th>
                                        <th scope="col">Tweet Link</th>
                                        <th scope="col">Active</th>
                                        <th scope="col">Must Be Following?</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var rule in @Model.Rules)
                                    {
                                        <tr>
                                            <td scope="row">
                                                @rule.WatchType.ToString()
                                            </td>
                                            <td>@rule.WatchValue</td>
                                            <td>
                                                @if(@rule.ExternalId == "0")
                                                {
                                                    <span>Tweet is Scheduled</span>
                                                }
                                                else
                                                {
                                                    <a href="@linkBuilder.BuildTwitterLink(@rule.ExternalId).Result" target="_blank">@rule.ExternalId</a>
                                                }
                                            </td>
                                            <td>
                                                @if (@rule.ActiveInd)
                                                {
                                                    <span>True</span>
                                                }
                                                else
                                                {
                                                    <span>False</span>
                                                }
                                            </td>
                                            <td>
                                                @if(@rule.MustBeFollowing)
                                                {
                                                    <span>True</span>
                                                }
                                                else
                                                {
                                                    <span>False</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="me-0">
                                                    <button class="btn btn-sm btn-bg-light btn-active-color-primary"
                                                        data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
                                                        <div>Actions</div>
                                                    </button>
                                                    <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
                                                        <div class="menu-item px-3">
                                                            <div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase">
                                                                Rule Actions
                                                            </div>
                                                        </div>
                                                        <div class="menu-item px-3">
                                                            <a asp-action="Update" asp-controller="SweepRules"
                                                                asp-route-sweepUid="@rule.RuleUid" class="menu-link px-3">
                                                                Edit
                                                            </a>
                                                        </div>
                                                        @if(rule.ExternalId != "0")
                                                        {
                                                            <div class="menu-item px-3">
                                                                <a 
                                                                    asp-action="Delte" 
                                                                    asp-controller="SweepRules"
                                                                    asp-route-sweepUid="@Model.Sweepstake.SweepUid"
                                                                    asp-route-ruleUid="@rule.RuleUid"
                                                                    asp-route-actionName=@ViewContext.RouteData.Values["action"]
                                                                    asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
                                                                    class="menu-link flex-stack px-3">
                                                                    Delete
                                                                </a>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="menu-item px-3">
                                                                <a 
                                                                    asp-action="DelteScheduledRule" 
                                                                    asp-controller="SweepRules"
                                                                    asp-route-sweepUid="@Model.Sweepstake.SweepUid"
                                                                    asp-route-ruleUid="@rule.RuleUid"
                                                                    asp-route-actionName=@ViewContext.RouteData.Values["action"]
                                                                    asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
                                                                    class="menu-link flex-stack px-3">
                                                                    Delete Scheduled
                                                                </a>
                                                            </div>
                                                        }
                                                        @if(rule.ActiveInd)
                                                        {
                                                            <div class="menu-item px-3">
                                                                <a 
                                                                    asp-action="Deactivate" 
                                                                    asp-controller="SweepRules"
                                                                     asp-route-sweepUid="@rule.RuleUid" 
                                                                     class="menu-link flex-stack px-3">
                                                                    Deactivate
                                                                </a>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="menu-item px-3">
                                                                <a asp-action="Activate" asp-controller="SweepRules"
                                                                asp-route-sweepUid="@rule.RuleUid" class="menu-link flex-stack px-3">
                                                                    Activate
                                                                </a>
                                                            </div>
                                                        }
                                                    </div
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer">
                            <a 
                            class="btn btn-primary"
                            asp-controller="SweepRules"
                            asp-action="SelectProvider"
                            asp-route-sweepUid="@Model.Sweepstake.SweepUid"
                            asp-route-actionName=@ViewContext.RouteData.Values["action"]
                            asp-route-controllerName=@ViewContext.RouteData.Values["controller"]>
                                Create New Watch
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">&nbsp;</div>
            </div>
            <div class="row">
                <div class="col-lg-6 col-md-6 col-sm-12">
                    <div class="card">
                        <div class="card-header">Entry Rules</div>
                        <div class="card-body">
                            @if(entryRuleExists)
                            {
                                <p class="card-text">Entries per user: @entryPerUser </p>
                                <hr />
                                <p class="card-text">
                                    <a asp-action="Update" 
                                    asp-controller="SweepEntryRule" 
                                    asp-route-entryRuleUid=@Model.EntryRule.EntryRuleUid
                                    asp-route-sweepUid=@Model.Sweepstake.SweepUid
                                    asp-route-actionName=@ViewContext.RouteData.Values["action"]
                                    asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
                                    class="btn btn-primary">
                                        Update Entry Rules
                                    </a>
                                </p>
                            }
                            else
                            {
                                <p class="card-text">There is no entry rule for this sweepstake.</p>
                                <hr />
                                <p class="card-text">
                                    <a 
                                    asp-action="Create" 
                                    asp-controller="SweepEntryRule" 
                                    asp-route-sweepUid=@Model.Sweepstake.SweepUid
                                    asp-route-actionName=@ViewContext.RouteData.Values["action"]
                                    asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
                                    class="btn btn-primary">
                                        Add One Now
                                    </a>
                                </p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-12">
                    <div class="card">
                        <div class="card-header">Draw Rules</div>
                        <div class="card-body">
                            @if(drawRuleExists)
                            {
                                <p class="card-text">Winner Count: @winnerCount</p>
                                <p class="card-text">Backup Per Winner: @winnerBackupCount</p>
                                <hr />
                                <p class="card-text">
                                    <a asp-action="Update" 
                                    asp-controller="SweepDrawRule" 
                                    asp-route-drawRuleUid=@Model.DrawRule.DrawRuleUid
                                    asp-route-sweepUid=@Model.Sweepstake.SweepUid
                                    asp-route-actionName=@ViewContext.RouteData.Values["action"]
                                    asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
                                    class="btn btn-primary">
                                        Update Draw Rules
                                    </a>
                                </p>
                            }
                            else
                            {
                                <p class="card-text">There is no draw rule for this sweepstake.</p>
                                <hr />
                                <p class="card-text">
                                    <a 
                                    asp-action="Create" 
                                    asp-controller="SweepDrawRule" 
                                    asp-route-sweepUid=@Model.Sweepstake.SweepUid
                                    asp-route-actionName=@ViewContext.RouteData.Values["action"]
                                    asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
                                    class="btn btn-primary">
                                        Add One Now
                                    </a>
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>