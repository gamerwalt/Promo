@model CreateNewSweep
@{
    ViewData["Title"] = $"Create New Sweepstake/Raffle";
}
<div class="card card-bordered">
    <form asp-controller="Sweeps" asp-action="CreateNew" class="form-horizontal form-material mx-2">
        <div class="card-header">
            <h3 class="card-title">Create Sweepstake/Raffle</h3>
        </div>
        <div class="card-body">
            <div class="fv-row mb-8">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Name
                </label>
                <input type="text" asp-for="Name" id="Name" class="form-control" placeholder="Name" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="fv-row mb-8 w-lg-250px">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Start Date
                </label>
                <input asp-for="StartDate" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" placeholder="StartDate" />
                <span asp-validation-for="StartDate"></span>
            </div>
            <div class="fv-row mb-8 w-lg-250px">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    End Date
                </label>
                <input asp-for="EndDate" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" placeholder="EndDate" />
                <span asp-validation-for="EndDate"></span>
            </div>
            <div class="fv-row mb-8 w-lg-250px">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Draw Date
                </label>
                <input asp-for="DrawDate" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" placeholder="DrawDate" />
                <span asp-validation-for="DrawDate"></span>
            </div>
            <div class="fv-row mb-8 w-lg-500px">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Promotion
                </label>
                <select asp-for="Campaign.CampaignUid" asp-items=@Model.Promotions class="form-select form-control-lg">
                    <option value="@Guid.Empty">Please select promotion</option>
                </select>
                <span asp-validation-for="Campaign.CampaignUid"></span>
            </div>
            <div class="fv-row mb-8 w-lg-500px">
                <div class="form-check form-check-solid form-switch fv-row">
                    <input class="form-check-input w-45px h-30px" type="checkbox" asp-for="AcceptTerms" />
                    <label class="form-check-label" for="allowmarketing">
                        Accept <a target="_blank" asp-controller="Terms" asp-action="SweepstakesTermsAndConditions" class="link-primary">Game and Prizes Terms and Conditions</a>
                        <br />
                        <span asp-validation-for="AcceptTerms"></span>
                    </label>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="card-toolbar">
                <button type="submit" class="btn btn-md btn-light btn-primary">
                    Create Sweepstake
                </button>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
