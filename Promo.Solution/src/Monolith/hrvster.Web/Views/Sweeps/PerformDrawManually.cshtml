@model PerformDrawManually
@{
	ViewData["Title"] = $"Perform manual draw for {@Model.SweepstakeAndRules.Sweepstake.Name}";
	var winnerUids = string.Join(",", Model.Winners.Select(c => c.SweepWinnerUid));
	var winnerUserIdentifier = string.Join(",", Model.Winners.Select(c => c.UserIdentifier));
	var entrantsUserIdentifier = string.Join(",", Model.SweepstakeEntrants.Select(c => c.UserIdentifier));
}
<div class="card card-flush">
	<div class="card-body pt-9 pb-0">
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			<div class="flex-grow-1">
				<div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
					<div class="d-flex flex-column">
						<div class="d-flex align-items-center mb-1">
							<div class="fs-2 fw-bold me-3 text-primary ">@Model.SweepstakeAndRules.Sweepstake.Name</div>
						</div>
						<div class="d-flex flex-wrap fw-semibold mb-4 fs-5 text-gray-400">
							@Model.SweepstakeAndRules.Sweepstake.RulesUrl
						</div>
					</div>
				</div>
				<div class="d-flex flex-wrap justify-content-start mb-2">
					<div class="d-flex flex-wrap">
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400">Start Date</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.SweepstakeAndRules.Sweepstake.StartDate.ToString("MMM dd, yyyy, hh:mm:ss tt")</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400">End Date</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.SweepstakeAndRules.Sweepstake.EndDate.ToString("MMM dd, yyyy, hh:mm:ss tt")</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			<div>There is/are now @Model.SweepstakeEntrants.Count() entrants into the sweepstakes.<br /></div>
		</div>
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			<div>We will not be selecting any backups.<br /></div>
		</div>
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			<div>Your winner count rule is @Model.SweepstakeAndRules.DrawRule.WinnerCount.<br /></div>
		</div>
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			<div>By performing any of the actions below, you agree that there will no backup winners.</div>
		</div>
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			@if(Model.SweepstakeEntrants.Count() == 1)
			{
				<div>Click the [Select a Winner] button to select the last entrant.</div>
			}
		</div>
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			@if (Model.SweepstakeEntrants.Count() > 0 &&
					Model.Winners.Count < Model.SweepstakeAndRules.DrawRule.WinnerCount)
			{
				<div class="separator"></div>
				<div class="flex-grow-1">
					<form asp-action="PerformDrawManually" asp-route-sweepUid="@Model.SweepstakeAndRules.Sweepstake.SweepUid">
						@Html.HiddenFor(c => winnerUids)
						@Html.HiddenFor(c => winnerUserIdentifier)
						@Html.HiddenFor(c => entrantsUserIdentifier)
						@Html.HiddenFor(c => c.SweepstakeAndRules.Sweepstake.SweepUid)
						<div class="border border-gray-300 border-dotted rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-danger">Select a winner will pick only 1 winner and allow you to view the winner before continuing to select the next.</div>
							<div class="d-flex align-items-center">
								<button name="WinnerSelectProcess" class="btn btn-primary" type="submit" value="Singular">Select a Winner</button>
							</div>
						</div>
						<div class="border border-gray-300 border-dotted rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-danger">Select winners will perform the draw only to the number of winners it can safely pick.</div>
							<div class="d-flex align-items-center">
								<button name="WinnerSelectProcess" class="btn btn-primary" type="submit" value="All">Select Winners</button>
							</div>
						</div>
						
					</form>
				</div>
			}
			else
			{
				<div>We cannot select again</div>
			}
		</div>
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			<div class="tab-pane fade show" id="winners" role="tabpanel">
				<div class="table-responsive">
					<table class="table table-striped">
						<thead>
							<tr class="fw-semibold fs-6 text-gray-800 border-bottom-2 border-gray-200">
								<th>User Identifier</th>
								<th>User Identifier Type</th>
								<th>Backups</th>
							</tr>
						</thead>
						<tbody>
							@if(Model.Winners.Count() == 0)
							{
								<tr>
									<td colspan="3">
										<div>No Current Winner Drawn</div>
									</td>
								</tr>
							}
							@foreach(var winner in Model.Winners)
							{
								<tr>
									<td>@winner.UserIdentifier</td>
									<td>@winner.UserIdentifierType</td>
									<td>
										No backups
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>