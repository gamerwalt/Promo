@using hrvster.Extensions.ModelExtensions
@using hrvster.Models.Sweepstakes
@model SweepstakeDetails
@{
    ViewData["Title"] = "Sweepstakes";
}
<div class="card card-flush">
	<div class="card-header mt-5">
		<div class="card-title flex-column">
			<h3 class="fw-bold mb-1">Sweepstakes</h3>
			<div class="fs-6 text-gray-400">@Model.SweepDetails.Count() sweepstake(s) so far</div>
		</div>
		<div class="card-toolbar my-1">
			<div class="me-6 my-1">
				<a asp-action="CreateNew" class="btn btn-sm btn-primary me-3">Add Sweepstake</a>
			</div>
		</div>
	</div>
	<div class="card-body pt-0">
		<div class="table-responsive">
			<table id="kt_profile_overview_table" class="table table-row-bordered table-row-dashed gy-4 align-middle fw-bold">
				<thead class="fs-7 text-gray-400 text-uppercase">
					<tr>
						<th class="min-w-250px">Name</th>
						<th class="min-w-150px">Harvested</th>
						<th class="min-w-150px">Entries</th>
						<th class="min-w-90px">User Entries</th>
						<th class="min-w-90px">Status</th>
						<th class="min-w-50px text-end">Details</th>
					</tr>
				</thead>
				<tbody class="fs-7">
					@foreach (var item in @Model.SweepDetails)
					{
						<tr>
							<td>
								<div class="d-flex align-items-center">
									<div class="me-5 position-relative">
										<div class="symbol symbol-35px symbol-circle">
											<div class="symbol-label fs-2 fw-semibold text-success">@item.Sweepstake.Name[0]</div>
										</div>
									</div>
									<div class="d-flex flex-column justify-content-center">
										<a asp-action="View" asp-route-sweepUid=@item.Sweepstake.SweepUid
									   class="fs-6 text-gray-800 text-hover-primary">@item.Sweepstake.Name</a>
										<div class="fs-8 fw-semibold text-gray-400">@item.Sweepstake.Campaign.CampaignName</div>
									</div>
								</div>
							</td>
							<td>@item.TweetsHarvested.Count</td>
							<td>@item.SweepEntries.Count</td>
							<td>
								<div class="symbol-group symbol-hover my-1">
									@foreach (var tweet in item.TweetsHarvested.DistinctBy(c => c.ExternalUserId).Take(15))
									{
										var url = $"https://twitter.com/{@tweet.ScreenName}";
										<a target="_blank" href=@url class="symbol symbol-35px symbol-circle" data-bs-toggle="tooltip" title="@tweet.ScreenName">
											<img alt="Pic" src="@tweet.ProfileImageUrl" />
										</a>
									}
								</div>
							</td>
							<td>
								@if(item.Sweepstake.IsActive())
								{
									<span class="badge badge-light-success fw-bold px-4 py-3" 
										data-bs-toggle="tooltip" 
										data-bs-placement="top"
										title="From @item.Sweepstake.StartDate.ToString("f") To @item.Sweepstake.EndDate.ToString("f")"
									>
										Active
									</span>
								}
								else if(item.Sweepstake.WillBeActiveInTheFuture())
								{
									<span class="badge badge-light-info fw-bold px-4 py-3"
										data-bs-toggle="tooltip"
										data-bs-placement="top"
										title="From @item.Sweepstake.StartDate.ToString("f") To @item.Sweepstake.EndDate.ToString("f")"
									>
										Will Be Active
									</span>
								}
								else
								{
									<span class="badge badge-light-danger fw-bold px-4 py-3"
										data-bs-toggle="tooltip"
										data-bs-placement="top"
										title="From @item.Sweepstake.StartDate.ToString("f") To @item.Sweepstake.EndDate.ToString("f")"
									>
											InActive
									</span>
								}
							</td>
							<td class="text-end">
								<a asp-action="View" asp-route-sweepUid=@item.Sweepstake.SweepUid
							   class="btn btn-light btn-sm">View</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>