@using hrvster.Models.Sweepstakes
@model SweepstakeDetails
@{
    ViewData["Title"] = "Sweepstakes";
}
<div id="kt_project_users_card_pane" class="tab-pane fade show active">
	<div class="row g-6 g-xl-9">
		@foreach(var item in @Model.SweepDetails)
		{
			<div class="col-md-6 col-xxl-4">
				<div class="card">
					<div class="card-body d-flex flex-center flex-column pt-12 p-9">
						<div class="symbol symbol-65px symbol-circle mb-5">
							<div class="symbol-label fs-2 fw-semibold text-success">@item.Sweepstake.Name[0]</div>
						</div>
						<a asp-controller="Sweeps" asp-action="View" asp-route-sweepUid=@item.Sweepstake.SweepUid
							class="fs-4 text-gray-800 text-hover-primary fw-bold mb-0">@item.Sweepstake.Name</a>
						<div class="fw-semibold text-gray-400 mb-6">Promotion: @item.Sweepstake.Campaign?.CampaignName</div>
						<div class="d-flex flex-center flex-wrap">
							<a asp-controller="TweetsHarvested" asp-action="View" asp-route-sweepUid=@item.Sweepstake.SweepUid
								class="border border-gray-300 border-dashed rounded min-w-80px py-3 px-4 mx-2 mb-3 ">
								<div class="fs-6 fw-bold text-gray-700">@item.TweetsHarvested?.Count</div>
								<div class="fw-semibold text-gray-400">Harvested</div>
							</a>
							<a asp-controller="SweepEntries" asp-action="View" asp-route-sweepUid=@item.Sweepstake.SweepUid
								class="border border-gray-300 border-dashed rounded min-w-80px py-3 px-4 mx-2 mb-3">
								<div class="fs-6 fw-bold text-gray-700 pulse">@item.SweepEntries?.Count</div>
								<div class="fw-semibold text-gray-400">Entries</div>
							</a>
							<div class="border border-gray-300 border-dashed rounded min-w-80px py-3 px-4 mx-2 mb-3">
								<div class="symbol-group symbol-hover my-1">
								@foreach(var tweet in item.TweetsHarvested.DistinctBy(c => c.ExternalUserId).Take(10))
								{
									var url = $"https://twitter.com/{@tweet.ScreenName}";
									<a target="_blank" href=@url class="symbol symbol-35px symbol-circle" data-bs-toggle="tooltip" title="@tweet.ScreenName">
										<img alt="Pic" src="@tweet.ProfileImageUrl" />
									</a>
								}
							</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
</div>