@using hrvster.Models.Extensions
@using hrvster.Core

@inject LinkBuilder linkBuilder
@model ViewSweepstake
@{
    ViewData["Title"] = @Model.Sweepstake.Name;
}

<div class="card card-flush">
    <div class="card-body pt-9 pb-0">
        <div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			<div class="flex-grow-1">
				<div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
					<div class="d-flex flex-column">
						<div class="d-flex align-items-center mb-1">
							<div class="fs-2 fw-bold me-3 text-primary ">@Model.Sweepstake.Name</div>
							@if (@Model.Sweepstake.IsActive())
							{
								<span class="badge badge-light-success me-auto">Is Active</span>
							}
							else if (@Model.Sweepstake.WillBeInProgress())
							{
								<span class="badge badge-light-info me-auto">Future Progress</span>
							}
							else
							{
								<span class="badge badge-light-danger me-auto">InActive</span>
							}
						</div>
						<div class="d-flex flex-wrap fw-semibold mb-4 fs-5 text-gray-400">
							@Model.Sweepstake.RulesUrl
						</div>
					</div>
				</div>
				<div class="d-flex flex-wrap justify-content-start mb-2">
					<div class="d-flex flex-wrap">
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400">Start Date</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.Sweepstake.StartDate.ToString("MMM dd, yyyy, hh:mm:ss tt")</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400">End Date</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.Sweepstake.EndDate.ToString("MMM dd, yyyy, hh:mm:ss tt")</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400">Entries</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.SweepEntries.Count()</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="separator"></div>
		@if (Model.SweepNotification.DrawAttemptHappened)
		{
			<div class="d-flex flex-wrap justify-content-start mb-2">
				<div class="d-flex flex-wrap">
					<div class="min-w-200px py-3 px-4 me-6 mb-3">
						<div class="d-flex align-items-center">
							<div class="fs-4 fw-bold text-active-danger">
								An attempt was made to draw winners for your sweeps. 
								<br>To update the system to retry a draw, click the [Remove Attempt] button.
							</div>
						</div>
					</div>
					<div class="min-w-125px py-3 px-4 me-6 mb-3">
						<div class="d-flex align-items-center">
							<form asp-action="ToggleDrawAttempted" method="post" asp-route-sweepUid="@Model.Sweepstake.SweepUid">
								<button class="btn btn-primary mb-4" type="submit">Remove Attempt</button>
							</form>
						</div>
					</div>
				</div>
			</div>
		}
		@if(Model.SweepNotification.NotEnoughUniqueEntrants)
		{
			<div class="d-flex flex-wrap justify-content-start mb-2">
				<div class="d-flex flex-wrap">
					<div class="min-w-200px py-3 px-4 me-6 mb-3">
						<div class="d-flex align-items-center">
							<div class="fs-4 fw-bold text-active-danger">
								Your sweepstakes does not have enough entrants.
								<br>To perform a draw manually, click the [Perform Draw Manually] button.
							</div>
						</div>
					</div>
					<div class="min-w-125px py-3 px-4 me-6 mb-3">
						<div class="d-flex align-items-center">
							<a class="btn btn-primary mb-4" asp-action="PerformDrawManually" asp-route-sweepUid="@Model.Sweepstake.SweepUid">Perform Draw Manually</a>
						</div>
					</div>
				</div>
			</div>
		}
		<div class="separator"></div>
		<div class="card">
			<div class="card-header card-header-tabs">
				<div class="card-toolbar">
					<ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold">
						<li class="nav-item">
							<a class="nav-link text-active-primary py-5 me-6 active"
							   data-bs-toggle="tab"
							   href="#editDetails">
								Edit Details
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-active-primary py-5 me-6"
							   data-bs-toggle="tab"
							   href="#rules">
								Rules
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-active-primary py-5 me-6"
							   data-bs-toggle="tab"
							   href="#prizes">
								Prizes
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-active-primary py-5 me-6"
							   data-bs-toggle="tab"
							   href="#sweepEntries">
								Entries
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-active-primary py-5 me-6"
							   data-bs-toggle="tab"
							   href="#winners">
								Winners
							</a>
						</li>
					</ul>
				</div>
			</div>
			<div class="card-body">
				<div class="tab-content" id="promotionsTabContent">
					<div class="tab-pane fade active show" id="editDetails" role="tabpanel">
						<form 
							asp-action="View" 
							asp-route-sweepUid="@Model.Sweepstake.SweepUid">
							@Html.HiddenFor(m => m.UpdateSweepstake.SweepUid)
							@Html.HiddenFor(m => m.UpdateSweepstake.CampaignUid)
							<div class="card">
								<div class="card-body">
									<div class="fv-row mb-8">
										<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
											Sweepstake Name
										</label>
										<input type="text"
											   class="form-control form-control-solid"
											   placeholder="@Model.UpdateSweepstake.Name"
											   value="@Model.UpdateSweepstake.Name"
											   asp-for="@Model.UpdateSweepstake.Name" maxlength="90"/>
										<span asp-validation-for="@Model.UpdateSweepstake.Name"></span>
									</div>
									<div class="fv-row mb-6 w-lg-250px">
										<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
											Start Date
										</label>
										<input class="form-control form-control-solid"
											   asp-for="@Model.UpdateSweepstake.StartDate" />
										<span asp-validation-for="@Model.UpdateSweepstake.StartDate"></span>
									</div>
									<div class="fv-row mb-6 w-lg-250px">
										<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
											End Date
										</label>
										<input class="form-control form-control-solid"
											   asp-for="@Model.UpdateSweepstake.EndDate" />
										<span asp-validation-for="@Model.UpdateSweepstake.EndDate"></span>
									</div>
									<div class="fv-row mb-6 w-lg-250px">
										<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
											Draw Date
										</label>
										<input class="form-control form-control-solid"
											   asp-for="@Model.UpdateSweepstake.DrawDate"/>
										<span asp-validation-for="@Model.UpdateSweepstake.DrawDate"></span>
									</div>
								</div>
								<div class="card-footer">
									<button type="submit" class="btn btn-lg btn-primary">Update</button>
								</div>
							</div>
						</form>
					</div>
					<div class="tab-pane fade show" id="rules" role="tabpanel">
						<div class="table-responsive">
							<table class="table table-striped">
								<thead>
									<tr class="fw-semibold fs-6 text-gray-800 border-bottom-2 border-gray-200">
										<th>Watch Value</th>
										<th>Tweet</th>
										<th>Active</th>
										<th>Must Be Following?</th>
										<th>Notify Winners?</th>
										<th>Actions</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var rule in @Model.Rules)
									{
										<tr>
											<td>@rule.WatchValue</td>
											<td>
												@if (@rule.ExternalId == "0")
												{
													<a asp-action="View" asp-controller="ScheduledTweets"
											   asp-route-ruleUid="@rule.RuleUid"
											   asp-route-sweepUid="@Model.Sweepstake.SweepUid"
											   target="_blank">
														Scheduled
													</a>
												}
												else
												{
													<a href="@linkBuilder.BuildTwitterLink(rule.ExternalId, rule.RuleUid).Result" target="_blank">@rule.ExternalId</a>
												}
											</td>
											<td>
												@if (@rule.ActiveInd)
												{
													<span>True</span>
												}
												else
												{
													<span>False</span>
												}
											</td>
											<td>
												@if (@rule.MustBeFollowing)
												{
													<span>True</span>
												}
												else
												{
													<span>False</span>
												}
											</td>
											<td>
												<span>@rule.NotifyWinners</span>
											</td>
											<td>
												<div class="me-0">
													<button class="btn btn-sm btn-bg-light btn-active-color-primary"
														data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
														Actions
													</button>
													<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
														<div class="menu-item px-3">
															<div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase">
																Rule Actions
															</div>
														</div>
														@if (rule.ExternalId == "0")
														{
															<div class="menu-item px-3">
																<a asp-action="View"
														   asp-controller="ScheduledTweets"
														   asp-route-sweepUid="@Model.Sweepstake.SweepUid"
														   asp-route-ruleUid="@rule.RuleUid"
														   asp-route-actionName=@ViewContext.RouteData.Values["action"]
														   asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
														   target="_blank"
														   class="menu-link flex-stack px-3">
																	View
																</a>
															</div>
														}
														else
														{
															<div class="menu-item px-3">
																<a asp-action="View"
														   asp-controller="SweepRuleEntries"
														   asp-route-sweepUid="@Model.Sweepstake.SweepUid"
														   asp-route-ruleUid="@rule.RuleUid"
														   asp-route-actionName=@ViewContext.RouteData.Values["action"]
														   asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
														   target="_blank"
														   class="menu-link flex-stack px-3">
																	View Entries
																</a>
															</div>
														}
														@if (rule.ExternalId != "0")
														{
															<div class="menu-item px-3">
																<a asp-action="DeleteRule"
														   asp-controller="SweepRules"
														   asp-route-sweepUid="@Model.Sweepstake.SweepUid"
														   asp-route-ruleUid="@rule.RuleUid"
														   asp-route-actionName=@ViewContext.RouteData.Values["action"]
														   asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
														   class="menu-link flex-stack px-3">
																	Delete
																</a>
															</div>
														}
														else
														{
															<div class="menu-item px-3">
																<a asp-action="DeleteScheduledRule"
														   asp-controller="ScheduledTweets"
														   asp-route-sweepUid="@Model.Sweepstake.SweepUid"
														   asp-route-ruleUid="@rule.RuleUid"
														   asp-route-actionName=@ViewContext.RouteData.Values["action"]
														   asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
														   class="menu-link flex-stack px-3">
																	Delete Scheduled
																</a>
															</div>
														}
														@if (rule.ActiveInd)
														{
															<div class="menu-item px-3">
																<a asp-action="Deactivate"
														   asp-controller="SweepRules"
														   asp-route-sweepUid="@Model.Sweepstake.SweepUid"
														   asp-route-ruleUid="@rule.RuleUid"
														   asp-route-actionName=@ViewContext.RouteData.Values["action"]
														   asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
														   class="menu-link flex-stack px-3">
																	Deactivate
																</a>
															</div>
														}
														else
														{
															<div class="menu-item px-3">
																<a asp-action="Activate"
														   asp-controller="SweepRules"
														   asp-route-sweepUid="@Model.Sweepstake.SweepUid"
														   asp-route-ruleUid="@rule.RuleUid"
														   asp-route-actionName=@ViewContext.RouteData.Values["action"]
														   asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
														   class="menu-link flex-stack px-3">
																	Activate
																</a>
															</div>
														}
													</div>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
						<div class="separator mb-4"></div>
						<a class="btn btn-primary mb-4"
							asp-controller="SweepRules"
							asp-action="SelectProvider"
							asp-route-sweepUid="@Model.Sweepstake.SweepUid"
							asp-route-actionName=@ViewContext.RouteData.Values["action"]
							asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
						>
                            Create New Watch
                        </a>
						<div class="separator"></div>
						<div class="row p-0 mb-5 px-9">
							<div class="col">
								<div class="border border-dashed border-gray-300 text-center min-w-125px rounded pt-4 pb-2 my-3">
									<span class="fs-4 fw-semibold text-success d-block">Entry Per User</span>
									<span 
										class="fs-2hx fw-bold text-gray-900 counted" 
										data-kt-countup="true"
										data-kt-countup-value="@Model.EntryRule?.EntryPerUser"
										data-kt-initialized="1">
										@Model.EntryRule?.EntryPerUser
									</span>
									@if(Model.EntryRule == null)
									{
										<a 
											asp-action="Create"
											asp-controller="SweepEntryRule"
											asp-route-sweepUid="@Model.Sweepstake.SweepUid"
											asp-route-actionName="View"
											asp-route-controllerName="Sweeps"
										>
											Add
										</a>
									}

									@if (Model.SweepEntries.Count() < 1 && Model.EntryRule != null)
									{
										<a 
											asp-action="Update" 
											asp-controller="SweepEntryRule"
											asp-route-sweepUid="@Model.Sweepstake.SweepUid"
											asp-route-entryRuleUid="@Model.EntryRule?.EntryRuleUid">
											Update
										</a>
									}
								</div>
							</div>
							<div class="col">
								<div class="border border-dashed border-gray-300 text-center min-w-125px rounded pt-4 pb-2 my-3">
									<span class="fs-4 fw-semibold text-primary d-block">Winner Count</span>
									<span 
										class="fs-2hx fw-bold text-gray-900 counted" 
										data-kt-countup="true"
										  data-kt-countup-value="@Model.DrawRule?.WinnerCount"
										  data-kt-initialized="1">
										@Model.DrawRule?.WinnerCount
									</span>
									@if (Model.DrawRule == null)
									{
										<a asp-action="Create"
											asp-controller="SweepDrawRule"
											asp-route-sweepUid="@Model.Sweepstake.SweepUid"
											asp-route-actionName="View"
											asp-route-controllerName="Sweeps"
										>
											Add
										</a>
									}
									@if (Model.Winners.Count() < 1 && Model.DrawRule != null)
									{
										<a 
											asp-action="Update"
											asp-controller="SweepDrawRule"
											asp-route-sweepUid="@Model.Sweepstake.SweepUid"
											asp-route-drawRuleUid="@Model.DrawRule?.DrawRuleUid"
											asp-route-actionName="View"
											asp-route-controllerName="Sweeps">
											Update
										</a>
									}
								</div>
							</div>
							<div class="col">
								<div class="border border-dashed border-gray-300 text-center min-w-125px rounded pt-4 pb-2 my-3">
									<span class="fs-4 fw-semibold text-primary d-block">Backup Winner Count</span>
									<span 
										class="fs-2hx fw-bold text-gray-900 counted" 
										data-kt-countup="true"
										  data-kt-countup-value="@Model.DrawRule?.WinnerBackupCount"
										  data-kt-initialized="1">
										@Model.DrawRule?.WinnerBackupCount
									</span>
									@if (Model.DrawRule == null)
									{
										<a asp-action="Create"
											asp-controller="SweepDrawRule"
											asp-route-sweepUid="@Model.Sweepstake.SweepUid"
											asp-route-actionName="View"
											asp-route-controllerName="Sweeps"
										>
											Add
										</a>
									}
									@if (Model.Winners.Count() < 1 && Model.DrawRule != null)
									{
										<a asp-action="Update"
											asp-action="Update"
											asp-controller="SweepDrawRule"
											asp-route-sweepUid="@Model.Sweepstake.SweepUid"
											asp-route-drawRuleUid="@Model.DrawRule?.DrawRuleUid"
											asp-route-actionName="View"
											asp-route-controllerName="Sweeps">
											Update
										</a>
									}
								</div>
							</div>
						</div>
					</div>
					<div class="tab-pane fade show" id="prizes" role="tabpanel">
						<div class="table-responsive">
							<table class="table table-striped">
								<thead>
									<tr class="fw-semibold fs-6 text-gray-800 border-bottom-2 border-gray-200">
										<th>Position</th>
										<th>Name</th>
										<th>Description</th>
										<th>Value</th>
										<th>Actions</th>
									</tr>
								</thead>
									<tbody>
									@foreach(var prize in Model.Prizes)
									{
										<tr>
											<td>@prize.PrizePosition</td>
											<td>@prize.PrizeName</td>
											<td>@prize.PrizeDescription</td>
											<td>@prize.PrizeValue</td>
											<td>
												<div class="me-0">
													<button class="btn btn-sm btn-bg-light btn-active-color-primary"
														data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
														Actions
													</button>
													<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
														<div class="menu-item px-3">
															<div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase">
																Prize Actions
															</div>
														</div>
														<div class="menu-item px-3">
															<a asp-action="EditPrize"
																asp-controller="SweepPrizes"
																asp-route-sweepUid="@Model.Sweepstake.SweepUid"
																asp-route-prizeUid="@prize.PrizeUid"
																asp-route-actionName="View"
																asp-route-controllerName="Sweeps"
																class="menu-link flex-stack px-3">
																Update
															</a>
														</div>
														<div class="menu-item px-3">
															<a asp-action="DeletePrize"
															   asp-controller="SweepPrizes"
															   asp-route-sweepUid="@Model.Sweepstake.SweepUid"
															   asp-route-prizeUid="@prize.PrizeUid"
															   asp-route-actionName="View"
																asp-route-controllerName="Sweeps"
															   class="menu-link flex-stack px-3">
																Delete
															</a>
														</div>
													</div>
												</div>
											</td>
										</tr>
									}
								</tbody>
							</table>
							<div>
								@if (Model.DrawRule?.WinnerCount > Model.Prizes.Count())
								{
									<a asp-action="Create"
									asp-controller="SweepPrizes"
									asp-route-sweepUid="@Model.Sweepstake.SweepUid"
									asp-route-campaignUid="@Model.Sweepstake.Campaign.CampaignUid"
									asp-route-returnAction="View"
									asp-route-returnController="Sweeps"
								   class="btn btn-md btn-light btn-primary me-3">
										Create New Prize
									</a>
								}
							</div>
						</div>
					</div>
					<div class="tab-pane fade show" id="sweepEntries" role="tabpanel">
						<div class="table-responsive">
							<table class="table table-striped">
								<thead>
									<tr>
										<th class="min-w-250px">Identifier</th>
										<th>Identifier Type</th>
										<th>Entry Date</th>
									</tr>
								<thead>
								<tbody class="fs-6">
									@foreach (var item in Model.SweepEntries)
									{
										<tr>
											<td>
												@if(item.UserIdentifierType == hrvster.Models.UserIdentifierType.TwitterHandle)
												{
													<a href="@linkBuilder.BuildTwitterHandleLink(@item.UserIdentifier)" target="_blank">
														@item.UserIdentifier
													</a>
												}
												else
												{
													@item.UserIdentifier
												}
											</td>
											<td>@item.UserIdentifierType</td>
											<td>@item.CreatedDate.ToString("MMM dd, yyyy, hh:mm:ss tt")</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
					<div class="tab-pane fade show" id="winners" role="tabpanel">
						<div class="table-responsive">
							<table class="table table-striped">
								<thead>
									<tr class="fw-semibold fs-6 text-gray-800 border-bottom-2 border-gray-200">
										<th>User Identifier</th>
										<th>User Identifier Type</th>
										<th>Backups</th>
										<th>Prize</th>
										<th>Prize Position</th>
										<th>Actions</th>
									</tr>
								</thead>
								<tbody>
									@if(Model.Winners.Count() == 0)
									{
										<tr>
											<td colspan="3">
												<div>No Current Winner Drawn</div>
											</td>
										</tr>
									}
									@foreach(var winner in Model.Winners)
									{
										var prize = @Model.Prizes.FirstOrDefault(p => p.PrizePosition == winner.AssignedId);
										<tr>
											<td>@winner.UserIdentifier</td>
											<td>@winner.UserIdentifierType</td>
											<td>
												@foreach(var backupWinner in winner.BackupWinners)
												{
													<div>@backupWinner.UserIdentifier - @backupWinner.UserIdentifierType</div>
												}
											</td>
											<td>@prize.PrizeName</td>
											<td>@prize.PrizePosition</td>
											<td>
												@if(!winner.FulfilledInd)
												{
													<div class="me-0">
														<button class="btn btn-sm btn-bg-light btn-active-color-primary"
															data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
															Actions
														</button>
														<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
															<div class="menu-item px-3">
																<div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase">
																	Prize Actions
																</div>
															</div>
														
																<div class="menu-item px-3">
																	<a asp-action="FulfillWinner"
																		asp-controller="SweepWinners"
																		asp-route-sweepUid="@Model.Sweepstake.SweepUid"
																		asp-route-prizeUid="@prize.PrizeUid"
																		asp-route-sweepWinnerUid="@winner.SweepWinnerUid"
																		asp-route-actionName="View"
																		asp-route-controllerName="Sweeps"
																		class="menu-link flex-stack px-3">
																		Set as Fulfilled
																	</a>
																</div>
																@if(winner.BackupWinners.Count() > 0)
																{
																	<div class="menu-item px-3">
																		<a asp-action="PromoteBackup"
																			asp-controller="SweepWinners"
																			asp-route-sweepUid="@Model.Sweepstake.SweepUid"
																			asp-route-prizeUid="@prize.PrizeUid"
																			asp-route-sweepWinnerUid="@winner.SweepWinnerUid"
																			asp-route-actionName="View"
																			asp-route-controllerName="Sweeps"
																			class="menu-link flex-stack px-3">
																			Promote Backup
																		</a>
																	</div>
																}
														</div>
													</div>
												}
												else
												{
													<span>Fulfilled</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
    </div>
</div>

@section Scripts {
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}
