@model ViewSweepPrizes
@{
	ViewData["Title"] = "Prizes for " + Model.Sweep.Name;
}
<div class="card card-flush">
		<div class="card-header mt-5">
			<div class="card-title flex-column">
				<h3 class="fw-bold mb-1">Prizes</h3>
			</div>
		</div>
		<div class="card-body pt-0 my-4">
			<div class="table-responsive">
				@if (Model.Prizes.Count() > 1)
				{
					<table class="table table-striped">
						<thead>
							<tr>
								<th>Position</th>
								<th>Name</th>
								<th>Value</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var prize in Model.Prizes)
							{
								<tr>
									<td>@prize.PrizePosition</td>
									<td>@prize.PrizeName</td>
									<td>@prize.PrizeValue</td>
									<td class="card-toolbar">
										<button class="btn btn-primary btn-sm" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end" data-kt-menu-overflow="true">Action</button>
									<div class="px-2 py-2 menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px" data-kt-menu="true" style="">
										<div class="menu-item px-3">
											@Html.ActionLink("Edit", "EditPrize", "CreateSweepPrizes", new { sweepUid = Model.Sweep.SweepUid, prizeUid = prize.PrizeUid}, new { @class="menu-link px-3"})
										</div>
										<div class="menu-item px-3">
											@Html.ActionLink("Delete", "DeletePrize", "CreateSweepPrizes", new { sweepUid = Model.Sweep.SweepUid, prizeUid = prize.PrizeUid}, new { @class="menu-link px-3"})
										</div>
									</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</div>
		<div class="card-footer">
			<div class="d-flex flex-stack pt-10">
				<div class="me-2">
					<a class="btn btn-lg btn-light-primary me-3" asp-controller="CreateDrawRules" asp-action="View" asp-route-sweepUid=@Model.Sweep.SweepUid>
						<span class="svg-icon svg-icon-3 me-1">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<rect opacity="0.5" x="6" y="11" width="13" height="2" rx="1" fill="currentColor"></rect>
								<path d="M8.56569 11.4343L12.75 7.25C13.1642 6.83579 13.1642 6.16421 12.75 5.75C12.3358 5.33579 11.6642 5.33579 11.25 5.75L5.70711 11.2929C5.31658 11.6834 5.31658 12.3166 5.70711 12.7071L11.25 18.25C11.6642 18.6642 12.3358 18.6642 12.75 18.25C13.1642 17.8358 13.1642 17.1642 12.75 16.75L8.56569 12.5657C8.25327 12.2533 8.25327 11.7467 8.56569 11.4343Z" fill="currentColor"></path>
							</svg>
						</span>
						Back
					</a>
				</div>
				@if(Model.Prizes.Count() < Model.WinnerCount)
				{
					<div class="me-2">
						<a class="btn btn-lg btn-light-primary me-3" asp-action="Create" asp-route-sweepUid=@Model.Sweep.SweepUid>
							Add New Prize
						</a>
					</div>
				}
				<div>
					<a type="submit" class="btn btn-lg btn-primary" asp-controller="CreateTweet" asp-action="SelectProvider" asp-route-sweepUid="@Model.Sweep.SweepUid">
						Continue
						<span class="svg-icon svg-icon-3 ms-1 me-0">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
								<rect opacity="0.5" x="18" y="13" width="13" height="2" rx="1" transform="rotate(-180 18 13)" fill="currentColor"></rect>
								<path d="M15.4343 12.5657L11.25 16.75C10.8358 17.1642 10.8358 17.8358 11.25 18.25C11.6642 18.6642 12.3358 18.6642 12.75 18.25L18.2929 12.7071C18.6834 12.3166 18.6834 11.6834 18.2929 11.2929L12.75 5.75C12.3358 5.33579 11.6642 5.33579 11.25 5.75C10.8358 6.16421 10.8358 6.83579 11.25 7.25L15.4343 11.4343C15.7467 11.7467 15.7467 12.2533 15.4343 12.5657Z" fill="currentColor"></path>
							</svg>
						</span>
					</a>
				</div>
			</div>
		</div>
</div>