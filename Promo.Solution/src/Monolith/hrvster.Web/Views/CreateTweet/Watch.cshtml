@model CreateSweepRuleTweet
@{
    ViewData["Title"] = $"Let's create your hashtag/watch value";
}
<div class="card card-borderedd">
    <form asp-action="Watch" asp-route-sweepUid="@Model.SweepstakeUid">
        <div class="card-header">
            <h3 class="card-title">Create/Publish Tweet for @Model.SweepstakeName</h3>
        </div>
        <div class="card-body">
            <div class="fv-row mb-8">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Watch Type
                </label>
                <select asp-for="WatchTypeId"
                        asp-items=@Model.WatchTypes class="form-select form-control-lg">
                    <option value="0">Please select one</option>
                </select>
                <span asp-validation-for="WatchTypeId"></span>
            </div>
            <div class="fv-row mb-8">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Watch Value
                </label>
                <div class="col-md-6">
                    <input class="form-control form-control-lg"
                           id="WatchValue"
                           asp-for="WatchValue" maxlength="50" />
                    <span asp-validation-for="WatchValue"></span>
                </div>
            </div>
            <div class="fv-row mb-8">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Tweet (Max 140)
                </label>
                <textarea name="TweetText"
                          class="form-control form-control-lg"
                          id="TweetText"
                          asp-for="TweetText" rows="5" cols="70" maxlength="135"></textarea>
                <span asp-validation-for="TweetText"></span>
            </div>
            <div class="fv-row mb-8">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Immediate / Scheduled
                </label>
                <div data-kt-buttons="true" class="w-lg-50">
                    <label class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex flex-stack text-start p-6 mb-5">
                        <div class="d-flex align-items-center me-2" id="immediateRadioDiv">
                            <div class="form-check form-check-custom form-check-solid form-check-primary me-6">
                                <input class="form-check-input" asp-for="PostNow" id="PostNow" name="PostNow" type="radio" value="true" />
                            </div>
                            <div class="flex-grow-1">
                                <h2 class="d-flex align-items-center fs-3 fw-bold flex-wrap">
                                    Immediate
                                </h2>
                                <div class="fw-semibold opacity-50">
                                    Tweet goes out immediately
                                </div>
                            </div>
                        </div>
                    </label>
                    <label class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex flex-stack text-start p-6 mb-5 active">
                        <div class="d-flex align-items-center me-2" id="scheduleRadioDiv">
                            <div class="form-check form-check-custom form-check-solid form-check-primary me-6">
                                <input class="form-check-input" type="radio" asp-for="PostNow" id="PostNow" name="PostNow" checked="checked" value="false" />
                            </div>
                            <div class="flex-grow-1">
                                <h2 class="d-flex align-items-center fs-3 fw-bold flex-wrap">
                                    Scheduled
                                    <span class="badge badge-light-success ms-2 fs-7">Most Recommended</span>
                                </h2>
                                <div class="fw-semibold opacity-50">
                                    Tweet goes out at scheduled time
                                </div>
                            </div>
                        </div>
                    </label>
                </div>
                <div class="col-md-12" id="scheduleDiv">
                    <div class="fv-row mb-8 w-lg-400px">
                        <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                            Date
                        </label>
                        <input asp-for="ScheduledDate" class="form-control form-control-lg" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                        <span asp-validation-for="ScheduledDate"></span>
                    </div>
                </div>
            </div>
            <div class="fv-row mb-8 w-lg-500px">
                <label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Picture 1
                </label>
                <input class="form-control"
                       id="Media1"
                       asp-for="Media1"
                       type="file" />
                <span asp-validation-for="Media1"></span>
            </div>
            <div class="fv-row mb-8 w-lg-500px">
                <label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Picture 2
                </label>
                <input class="form-control"
                       id="Media2"
                       asp-for="Media2"
                       type="file" />
                <span asp-validation-for="Media2"></span>
            </div>
            <div class="fv-row mb-8 w-lg-500px">
                <label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Picture 3
                </label>
                <input class="form-control"
                       id="Media3"
                       asp-for="Media3"
                       type="file" />
                <span asp-validation-for="Media3"></span>
            </div>
            <div class="fv-row mb-8 w-lg-500px">
                <label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Picture 4
                </label>
                <input class="form-control"
                       id="Media4"
                       asp-for="Media4"
                       type="file" />
                <span asp-validation-for="Media4"></span>
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex flex-stack pt-10">
                <div class="me-2">
                    <a class="btn btn-lg btn-light-primary me-3" asp-action="SelectProvider" asp-controller="CreateTweet" asp-route-sweepUid="@Model.SweepstakeUid">
                        <span class="svg-icon svg-icon-3 me-1">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect opacity="0.5" x="6" y="11" width="13" height="2" rx="1" fill="currentColor"></rect>
                                <path d="M8.56569 11.4343L12.75 7.25C13.1642 6.83579 13.1642 6.16421 12.75 5.75C12.3358 5.33579 11.6642 5.33579 11.25 5.75L5.70711 11.2929C5.31658 11.6834 5.31658 12.3166 5.70711 12.7071L11.25 18.25C11.6642 18.6642 12.3358 18.6642 12.75 18.25C13.1642 17.8358 13.1642 17.1642 12.75 16.75L8.56569 12.5657C8.25327 12.2533 8.25327 11.7467 8.56569 11.4343Z" fill="currentColor"></path>
                            </svg>
                        </span>
                        Back
                    </a>
                </div>
                <div>
                    <button type="submit" class="btn btn-lg btn-primary">
                        Continue
                        <span class="svg-icon svg-icon-3 ms-1 me-0">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect opacity="0.5" x="18" y="13" width="13" height="2" rx="1" transform="rotate(-180 18 13)" fill="currentColor"></rect>
                                <path d="M15.4343 12.5657L11.25 16.75C10.8358 17.1642 10.8358 17.8358 11.25 18.25C11.6642 18.6642 12.3358 18.6642 12.75 18.25L18.2929 12.7071C18.6834 12.3166 18.6834 11.6834 18.2929 11.2929L12.75 5.75C12.3358 5.33579 11.6642 5.33579 11.25 5.75C10.8358 6.16421 10.8358 6.83579 11.25 7.25L15.4343 11.4343C15.7467 11.7467 15.7467 12.2533 15.4343 12.5657Z" fill="currentColor"></path>
                            </svg>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>