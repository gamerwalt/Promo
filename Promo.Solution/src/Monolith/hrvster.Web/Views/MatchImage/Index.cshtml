@model MatchGameImages
@{
	ViewData["Title"] = $"Images for {Model.MatchGame.Name}";
}
<div class="card card-flush">
	<div class="card-header mt-5">
		<div class="card-title flex-column">
			<div class="fs-6 text-gray-400">@Model.MatchImages.Count() Image(s) so far</div>
		</div>
		<div class="card-toolbar my-1">
			<div class="me-6 my-1">
				<a asp-action="create" asp-route-matchGameUid="@Model.MatchGame.MatchGameUid" class="btn btn-sm btn-primary me-3">Add Image</a>
			</div>
		</div>
	</div>
	<div class="card-body pt-0">
		<div class="table-responsive">
			<table id="kt_profile_overview_table" class="table table-row-bordered table-row-dashed gy-4 align-middle fw-bold">
				<thead class="fs-7 text-gray-400 text-uppercase">
					<tr>
						<th class="min-w-250px">Uid</th>
						<th class="min-w-250px">Location</th>
						<th class="min-w-150px">Thumbnail</th>
						<th class="min-w-150px">Size</th>
						<th class="min-w-90px">Actions</th>
					</tr>
				</thead>
				<tbody class="fs-7">
					@foreach (var image in Model.MatchImages)
					{
						<tr>
							<td>
								<div class="d-flex flex-column justify-content-center">
									<a asp-action="View" asp-route-matchImageUid=@image.Uid
								   class="fs-6 text-gray-800 text-hover-primary">@image.Uid</a>
								</div>
							</td>
							<td>@image.LocationUrl</td>
							<td><span>Thumbnail here</span></td>
							<td><span>Size Here</span></td>
							<td>Actions</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>