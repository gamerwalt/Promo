@using hrvster.Core;
@using hrvster.Models;

@inject LinkBuilder linkBuilder

@model MatchGameDetails
@{
	ViewData["Title"] = $"View Match Game";
	var totalQuantityOfPrizes = 0;
}
<style>
	.btn-extra-sm {
		padding: 0.25rem 0.5rem;
		font-size: 0.785rem;
		line-height: 1.4;
		border-radius: 0.2rem;
	}
</style>
<div class="card card-flush">
	<div class="card-body pt-9 pb-0">
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			<div class="flex-grow-1">
				<div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
					<div class="d-flex flex-column">
						<div class="d-flex align-items-center mb-1">
							@if (@Model.MatchGame.IsActive())
							{
								<span class="badge badge-light-success me-auto">Is Active</span>
							}
							else if (@Model.MatchGame.WillBeInProgress())
							{
								<span class="badge badge-light-info me-auto">Future Progress</span>
							}
							else
							{
								<span class="badge badge-light-danger me-auto">InActive</span>
							}
						</div>
					</div>
				</div>
				<div class="d-flex flex-wrap justify-content-start mb-2">
					<div class="d-flex flex-wrap">
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400">Start Date</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.MatchGame.StartDate.ToString("f")</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400">End Date</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.MatchGame.EndDate.ToString("f")</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400"># of Boards</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.MatchGame.NumberOfBoards</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400"># Played</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.MatchPlays.Count()</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400"># Winnable</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.MatchGame.WinnableBoards</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400">Win Probability</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.MatchGame.WinProbability</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<div class="separator"></div>
<div class="card">
	<div class="card-header card-header-tabs">
		<div class="card-toolbar">
			<ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold">
				<li class="nav-item">
					<a class="nav-link text-active-primary py-5 me-6 active"
					   data-bs-toggle="tab"
					   href="#editDetails">
						Edit Details
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link text-active-primary py-5 me-6"
					   data-bs-toggle="tab"
					   href="#images">
						Images
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link text-active-primary py-5 me-6"
					   data-bs-toggle="tab"
					   href="#rules">
						Rules/Hashtags/Tweets
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link text-active-primary py-5 me-6"
					   data-bs-toggle="tab"
					   href="#prizes">
						Prizes
					</a>
				</li>
				<li class="nav-item">
					<a class="nav-link text-active-primary py-5 me-6"
					   data-bs-toggle="tab"
					   href="#plays">
						Plays and Winners
					</a>
				</li>
			</ul>
		</div>
	</div>
	<div class="card-body">
		<div class="tab-content" id="promotionsTabContent">
			<div class="tab-pane fade active show" id="editDetails" role="tabpanel">
				<form asp-controller="MatchGames" asp-action="View" asp-route-Uid="@Model.MatchGame.MatchGameUid" class="form-horizontal form-material mx-2">
					@Html.HiddenFor(c => c.MatchGame.MatchGameUid)
					<div class="card-body">
						<div class="d-flex flex-column flex-lg-row">
							<div class="flex-lg-row-fluid me-lg-15 order-2 order-lg-1 mb-10 mb-lg-0">
								<div class="card">
									<div class="card-body">
										<div class="fv-row mb-8 w-lg-500px">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Promotion
											</label>
											<select asp-for="@Model.MatchGame.PromotionUid" asp-items="@Model.MatchGame.Promotions" class="form-select form-control-lg">
												<option value="@Guid.Empty">Please select promotion</option>
											</select>
											<span asp-validation-for="@Model.MatchGame.PromotionUid"></span>
										</div>
										<div class="fv-row mb-8">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Name
											</label>
											<input type="text" asp-for="@Model.MatchGame.Name" class="form-control" placeholder="Name" maxlength="90" />
											<span asp-validation-for="@Model.MatchGame.Name"></span>
										</div>
										<div class="fv-row mb-8">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Description
											</label>
											<textarea rows="6" cols="5" asp-for="@Model.MatchGame.Description" class="form-control" placeholder="Name" maxlength="90"></textarea>
											<span asp-validation-for="@Model.MatchGame.Description"></span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="d-flex flex-column flex-lg-row">
							<div class="flex-column flex-lg-row-auto w-100 w-lg-250px w-xxl-325px mb-8 mb-lg-0 me-lg-9 me-5">
								<div class="card">
									<div class="card-body">
										<div class="fv-row mb-8">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Number of Boards
											</label>
											<input type="number" asp-for="MatchGame.NumberOfBoards" class="form-control" placeholder="1" />
											<span asp-validation-for="MatchGame.NumberOfBoards"></span>
										</div>
										<div class="fv-row mb-8">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Winnable Boards
											</label>
											<input type="number" asp-for="MatchGame.WinnableBoards" class="form-control" placeholder="1" />
											<span asp-validation-for="MatchGame.WinnableBoards"></span>
										</div>
										<div class="fv-row mb-8">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Win Probability
											</label>
											<input type="number" asp-for="MatchGame.WinProbability" class="form-control" placeholder="1" />
											<span asp-validation-for="MatchGame.WinProbability"></span>
										</div>
									</div>
								</div>
							</div>
							<div class="flex-column flex-lg-row-auto w-100 w-lg-250px w-xxl-325px mb-8 mb-lg-0 me-lg-9 me-5">
								<div class="card">
									<div class="card-body">
										<div class="fv-row mb-8 w-lg-300px">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Start Date
											</label>
											<input asp-for="MatchGame.StartDate" class="form-control" />
											<span asp-validation-for="MatchGame.StartDate"></span>
										</div>
										<div class="fv-row mb-8 w-lg-300px">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												End Date
											</label>
											<input asp-for="MatchGame.EndDate" class="form-control" />
											<span asp-validation-for="MatchGame.EndDate"></span>
										</div>
										<div class="fv-row mb-8 w-lg-300px">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Board Generation Date
											</label>
											<input asp-for="MatchGame.GenerateBoardDate" class="form-control" />
											<span asp-validation-for="MatchGame.GenerateBoardDate"></span>
										</div>
									</div>
								</div>
							</div>
							<div class="flex-column flex-lg-row-auto w-100 w-lg-250px w-xxl-325px mb-8 mb-lg-0 me-lg-9 me-5">
								<div class="card">
									<div class="card-body">
										<div class="form-check form-check-solid form-switch fv-row mb-8 mt-4">
											<label class="form-label form-check-label fs-6 fw-semibold" for="AccumulatePointsOnLoss">
												<input class="form-check-input w-45px h-30px" type="checkbox" asp-for="MatchGame.AccumulatePointsOnLoss" />
												Accumulate Points on Loss
												<br />
												<span asp-validation-for="MatchGame.AccumulatePointsOnLoss"></span>
											</label>
										</div>
										<div class="fv-row mb-8">
											<label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Points Per Loss
											</label>
											<input type="number" asp-for="MatchGame.PointsPerLoss" id="PointsPerLoss"
												   class="form-control" placeholder="1" />
											<span asp-validation-for="MatchGame.PointsPerLoss"></span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="card-footer">
						@* @if(!Model.MatchGame.IsGenerated)
						{ *@
							<div class="card-toolbar">
								<button type="submit" class="btn btn-md btn-light btn-primary">
									Update
								</button>
							</div>
						@* } *@
					</div>
				</form>
			</div>
			<div class="tab-pane fade" id="images" role="tabpanel">
				<a class="btn btn-primary mb-4"
				   asp-controller="MatchImages"
				   asp-action="Create"
				   asp-route-matchGameUid="@Model.MatchGame.MatchGameUid"
				   asp-route-actionName=@ViewContext.RouteData.Values["action"]
				   asp-route-controllerName=@ViewContext.RouteData.Values["controller"]>
					Create New Image
				</a>
				<div class="separator mb-4"></div>
				<div class="table-responsive">
					<table class="table table-striped">
						<thead>
							<tr class="fw-semibold fs-6 text-gray-800 border-bottom-2 border-gray-200">
								<th>Image</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var image in Model.MatchImages)
							{
								<tr>
									<td>
										<img class="mx-auto" width="64px" height="64px" src="@image.LocationUrl" alt="MatchGameImage" />
									</td>
									<td>
										<a class="btn btn-primary btn-sm mb-4"
											asp-controller="MatchImages"
											asp-action="Update"
											asp-route-matchGameUid="@Model.MatchGame.MatchGameUid"
											asp-route-matchImageUid="@image.Uid"
											asp-route-actionName=@ViewContext.RouteData.Values["action"]
											asp-route-controllerName=@ViewContext.RouteData.Values["controller"]>
											Update Image
										</a>
										<a class="btn btn-danger btn-sm mb-4"
											asp-controller="MatchImages"
											asp-action="Delete"
											asp-route-matchGameUid="@Model.MatchGame.MatchGameUid"
											asp-route-matchImageUid="@image.Uid"
											asp-route-actionName=@ViewContext.RouteData.Values["action"]
											asp-route-controllerName=@ViewContext.RouteData.Values["controller"]>
											Delete Image
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
			<div class="tab-pane fade" id="rules" role="tabpanel">
				<div class="table-responsive">
					<table class="table table-striped">
						<thead>
							<tr class="fw-semibold fs-6 text-gray-800 border-bottom-2 border-gray-200">
								<th>Watch Value</th>
								<th>Tweet/Link</th>
								<th>Active</th>
								<th>Must Be Following?</th>
								<th>Notify Winners?</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach(var rule in Model.MatchRules)
							{
								<tr>
									<td>@rule.WatchValue</td>
									<td>
										@if (@rule.ExternalId == "0")
										{
											<a href="@rule.UrlLink">Right Click and Copy</a>
										}
										else
										{
											@if(rule.ExternalClientType == ExternalClientType.Twitter)
											{
												<a href="@linkBuilder.BuildTwitterLink(rule.ExternalId, rule.RuleUid).Result" target="_blank">@rule.ExternalId</a>
											}
											else
											{
												<a href="@linkBuilder.BuildFacebookLink(rule.ExternalId, rule.RuleUid).Result" target="_blank">@rule.ExternalId</a>
											}
										}
									</td>
									<td>
										@if (@rule.IsActive)
										{
											<span>True</span>
										}
										else
										{
											<span>False</span>
										}
									</td>
									<td>
										@if (@rule.MustBeFollowing)
										{
											<span>True</span>
										}
										else
										{
											<span>False</span>
										}
									</td>
									<td>
										<span>@rule.NotifyWinners</span>
									</td>
									<td>
										<div class="me-0">
											<button class="btn btn-sm btn-bg-light btn-active-color-primary" 
												data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
												Actions
											</button>
											<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
												<div class="menu-item px-3">
													<div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase">
														Rule Actions
													</div>
												</div>
												@if (rule.ExternalId == "0")
												{
													<div class="menu-item px-3">
														<a asp-action="View"
														   asp-controller="ScheduledPosts"
														   asp-route-gameUid="@Model.MatchGame.MatchGameUid"
														   asp-route-ruleUid="@rule.RuleUid"
														   asp-route-actionName=@ViewContext.RouteData.Values["action"]
														   asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
														   target="_blank"
														   class="menu-link flex-stack px-3">
															View
														</a>
													</div>
												}
												else
												{
													<div class="menu-item px-3">
														<a 
															asp-action="Delete"
															asp-controller="MatchRules"
															asp-route-gameUid="@Model.MatchGame.MatchGameUid"
															asp-route-ruleUid="@rule.RuleUid"
															asp-route-actionName=@ViewContext.RouteData.Values["action"]
															asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
															class="menu-link flex-stack px-3">
															Delete
														</a>
													</div>
													<div class="menu-item px-3">
														<a asp-action="View"
														   asp-controller="MatchGamePlays"
														   asp-route-gameUid="@Model.MatchGame.MatchGameUid"
														   asp-route-ruleUid="@rule.RuleUid"
														   asp-route-actionName=@ViewContext.RouteData.Values["action"]
														   asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
														   target="_blank"
														   class="menu-link flex-stack px-3">
															View Gameplays
														</a>
													</div>
												}

												@if (rule.IsActive)
												{
													<div class="menu-item px-3">
														<a asp-action="Deactivate"
															asp-controller="MatchRules"
															asp-route-gameUid="@Model.MatchGame.MatchGameUid"
															asp-route-ruleUid="@rule.RuleUid"
															asp-route-actionName=@ViewContext.RouteData.Values["action"]
															asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
															class="menu-link flex-stack px-3">
															Deactivate
														</a>
													</div>
												}
												else
												{
													<div class="menu-item px-3">
														<a asp-action="Activate"
															asp-controller="MatchRules"
															asp-route-gameUid="@Model.MatchGame.MatchGameUid"
															asp-route-ruleUid="@rule.RuleUid"
															asp-route-actionName=@ViewContext.RouteData.Values["action"]
															asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
															class="menu-link flex-stack px-3">
															Activate
														</a>
													</div>
												}
											</div>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
					<div class="separator"></div>
					<a 
						asp-action="SelectProvider"
						asp-controller="Providers"
						asp-route-uid="@Model.MatchGame.MatchGameUid"
						asp-route-actionName=@ViewContext.RouteData.Values["action"]
						asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
						asp-route-gameType="@GameTypesEnum.MatchGames.ToString()"
						class="btn btn-lg btn-primary">
						Create Hashtag
					</a>
					<a asp-action="CreateLink"
					   asp-controller="Providers"
					   asp-route-uid="@Model.MatchGame.MatchGameUid"
					   asp-route-actionName=@ViewContext.RouteData.Values["action"]
					   asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
					   asp-route-gameType="@GameTypesEnum.MatchGames.ToString()"
					   class="btn btn-lg btn-secondary">
						Create Link
					</a>
				</div>
				<div class="separator"></div>
				<div class="separator"></div>
				<div class="row p-0 mb-5 px-9">
					<div class="col">
						<div class="border border-dashed border-gray-300 text-center min-w-125px rounded pt-4 pb-2 my-3">
							<span class="fs-4 fw-semibold text-success d-block">Entry Per User</span>
							<span class="fs-2hx fw-bold text-gray-900 counted"
								  data-kt-countup="true"
								  data-kt-countup-value="@Model.MatchPlayRule?.PlayPerGame"
								  data-kt-initialized="1">
								@Model.MatchPlayRule?.PlayPerGame
							</span>
							<span class="fs-4 fw-semibold text-success d-block">Entry Per Tweet</span>
							<span class="fs-2hx fw-bold text-gray-900 counted"
								  data-kt-countup="true"
								  data-kt-countup-value="@Model.MatchPlayRule?.PlayPerTweet"
								  data-kt-initialized="1">
								@Model.MatchPlayRule?.PlayPerTweet
							</span>
							<div class="separator"></div>
							@if (Model.MatchPlayRule == null)
							{
								<a asp-action="Create"
							   asp-controller="MatchPlayRules"
							   asp-route-Uid="@Model.MatchGame.MatchGameUid"
							   asp-route-actionName="View"
							   asp-route-controllerName="MatchGames" class="btn btn-lg btn-primary">
									Add
								</a>
							}

							@if (Model.PlayCount == 0)
							{
								@if (Model.MatchPlayRule?.PlayPerGame > 1)
								{
									<a asp-action="Update"
									   asp-controller="MatchPlayRules"
									   asp-route-Uid="@Model.MatchGame.MatchGameUid"
									   asp-route-entryRuleUid="@Model.MatchPlayRule?.Uid" class="btn btn-lg btn-primary">
										Update
									</a>
								}
							}
						</div>
					</div>
				</div>
			</div>
			<div class="tab-pane fade" id="prizes" role="tabpanel">
				<div class="table-responsive">
					<table class="table table-striped">
						<thead>
							<tr class="fw-semibold fs-6 text-gray-800 border-bottom-2 border-gray-200">
								<th>Name</th>
								<th>Description</th>
								<th>Value</th>
								<th>Image</th>
								<th>Quantity</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach(var prize in Model.MatchPrizes)
							{
								totalQuantityOfPrizes += prize.Quantity;

								<tr>
									<td>@prize.Name</td>
									<td>@prize.Description</td>
									<td>@prize.Value</td>
									<td>
										<img class="mx-auto" width="32px" height="32px" src="@prize.ImageUrl" alt="MatchGameImage" />
									</td>
									<td>@prize.Quantity</td>
									<td>
										@if (!Model.Generated)
										{
											<div class="me-0">
												<button class="btn btn-sm btn-bg-light btn-active-color-primary"
														data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
													Actions
												</button>
												<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
													<div class="menu-item px-3">
														<div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase">
															Prize Actions
														</div>
													</div>
													<div class="menu-item px-3">
														<a asp-action="Update"
														   asp-controller="MatchPrizes"
														   asp-route-Uid="@Model.MatchGame.MatchGameUid"
														   asp-route-prizeUid="@prize.Uid"
														   asp-route-actionName="View"
														   asp-route-controllerName="MatchGames"
															class="menu-link flex-stack px-3">
															Update
														</a>
													</div>
													<div class="menu-item px-3">
														<a asp-action="Delete"
														   asp-controller="MatchPrizes"
														   asp-route-Uid="@Model.MatchGame.MatchGameUid"
														   asp-route-prizeUid="@prize.Uid"
														   asp-route-actionName="View"
														   asp-route-controllerName="MatchGames"
															class="menu-link flex-stack px-3">
															Delete
														</a>
													</div>
												</div>
											</div>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
					<div class="separator"></div>
						<a 
							asp-action="Create"
							asp-controller="MatchPrizes"
							asp-route-uid="@Model.MatchGame.MatchGameUid"
							asp-route-actionName=@ViewContext.RouteData.Values["action"]
							asp-route-controllerName=@ViewContext.RouteData.Values["controller"]
							class="btn btn-lg btn-primary">
							Create Prize
						</a>
				</div>
			</div>
			<div class="tab-pane fade" id="plays" role="tabpanel">
				<div class="table-responsive">
					<table class="table table-striped">
						<thead>
							<tr class="fw-semibold fs-6 text-gray-800 border-bottom-2 border-gray-200">
								<th>ScreenName</th>
								<th>Played/Reserved</th>
								<th>Win</th>
								<th>Prize</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							@foreach(var win in Model.MatchPlays)
							{
								<tr>
									<td>@win.ScreenName</td>
									<td>
										@if(win.PlayedIndicator)
										{
											<span>Played</span>
										}
										else
										{
											<span>Reserved</span>
										}
									</td>
									<td>
										@if(win.WinIndicator)
										{
											<span>Won!</span>
										}
										else
										{
											@if(!win.WinIndicator && !win.PlayedIndicator)
											{
												<span>Not Played</span>
											}
											else
											{
												<span>Lost</span>
											}
										}
									</td>
									<td>@win.PrizeName</td>
									<td>
										@if(win.WinIndicator)
										{
											@if (!win.Fulfilled)
											{
												<form id="@win.Uid" asp-action="Fulfill" asp-route-gamePlayUid="@win.Uid" asp-route-Uid="@Model.MatchGame.MatchGameUid" asp-route-prizeUid="@win.PrizeUid">
													<button type="submit" class="btn btn-primary btn-extra-sm">Fulfill Prize</button>
												</form>
											}
											else
											{
												<span class="badge badge-success">Fulfilled on @win.DateFulfilled.GetValueOrDefault().ToString("MMM, dd, yyyy")</span>
											}
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>