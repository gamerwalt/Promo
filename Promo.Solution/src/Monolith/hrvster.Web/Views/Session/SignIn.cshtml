@using hrvster.Core.Requests.WebRequests
@model SigninForm
@{
    ViewData["Title"] = "Sign In";
}

<div class="text-center">
    <h1 class="display-4">Sign In</h1>
    @Html.ValidationMessage("CustomError")
</div>
<div>
    <div class="justify-content-center col-md-6">
        <div class="card">
            <div class="card-body">
                <form class="form-horizontal form-material mx-2" asp-controller="Session" asp-action="SignIn" >
                    <div class="form-group">
                        <label class="col-md-12" for="email">Email Address</label>
                        <div class="col-md-12">
                            <input 
                            type="email" 
                            id="Email" 
                            name="Email" 
                            placeholder="email@example.com" 
                            class="form-control form-control-line"
                            value="gamerwalt@hotmail.com">
                            <span asp-validation-for="Email" class="text-danger"></span> 
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-md-12" for="email">Password</label>
                        <div class="col-md-12">
                            <input 
                            type="password" 
                            id="Password" 
                            name="Password" 
                            class="form-control form-control-line"
                            value="progamer777">
                            <span asp-validation-for="Password" class="text-danger"></span>  
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-sm-12">
                        <button type="submit" class="btn btn-success text-white">
                            Sign In
                        </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
