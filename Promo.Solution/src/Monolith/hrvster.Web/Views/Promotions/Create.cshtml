@model CreatePromotion
@{
    ViewData["Title"] = "Create Promotion";
}
<div class="card card-bordered">
    <form asp-controller="Promotions" asp-action="Create" class="form-horizontal form-material mx-2">
        <div class="card-header">
            <h3 class="card-title">Create Promotion @Model.StartDate</h3>
        </div>
        <div class="card-body">
            <div class="fv-row mb-8">
				<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
					Promotion Name
				</label>
				<input type="text" 
					class="form-control form-control-solid"
                    id="Name"
                    placeholder="Name"
					asp-for="Name" maxlength="40" />
                <span asp-validation-for="Name"></span>
			</div>
            <div class="fv-row mb-8">
                <label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Description
                </label>
                <textarea 
                    asp-for="Description" id="Description" placeholder="Description"
                    class="form-control form-control-solid"
                    style="height: 100px" maxlength="450"></textarea>
                <span asp-validation-for="Description"></span>
            </div>
            <div class="fv-row mb-6 w-lg-300px">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    Start Date
                </label>
                <input class="form-control form-control-solid"
                    asp-for="StartDate"/>
                <span asp-validation-for="StartDate"></span>
            </div>
            <div class="fv-row mb-6 w-lg-300px">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
                    End Date
                </label>
                <input class="form-control form-control-solid"
                       asp-for="EndDate"/>
                <span asp-validation-for="EndDate"></span>
            </div>
            <div class="mb-4">
                <label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">Promotion Type</label>
                <select asp-for="CampaignTypeUid" asp-items=@Model.CampaignTypes class="form-select form-control-lg">
                    <option value="@Guid.Empty">Please select promotion type</option>
                </select>
                <span asp-validation-for="CampaignTypeUid"></span>
            </div>
        </div>
        <div class="card-footer">
            <div class="card-toolbar">
                <button type="submit" class="btn btn-md btn-light btn-primary">
                    Create Promotion
                </button>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
