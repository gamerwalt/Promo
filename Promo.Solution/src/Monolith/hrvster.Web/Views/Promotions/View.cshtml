@using hrvster.Web.Models
@model ViewPromotion
@{
    ViewData["Title"] = @Model.CampaignName;
}
<div class="card card-flush mt-6 mt-xl-9">
	<div class="card-body pt-9 pb-0">
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			<div class="flex-grow-1">
				<div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
					<div class="d-flex flex-column">
						<div class="d-flex align-items-center mb-1">
							<div class="fs-2 fw-bold me-3 text-primary ">@Model.CampaignName</div>
							@if (@Model.IsActive())
							{
								<span class="badge badge-light-success me-auto">In Progress</span>
							}
							else if (@Model.WillBeInProgress())
							{
								<span class="badge badge-light-info me-auto">Future Progress</span>
							}
							else
							{
								<span class="badge badge-light-danger me-auto">InActive</span>
							}
						</div>
						<div class="d-flex flex-wrap fw-semibold mb-4 fs-5 text-gray-400">
							@Model.Description
						</div>
					</div>
					<div class="d-flex mb-4">
						<a asp-controller="Sweeps" asp-action="Create" asp-route-campaignUid="@Model.CampaignUid"
							class="btn btn-sm btn-primary me-3">
							Add Sweepstake
						</a>
					</div>
				</div>
				<div class="d-flex flex-wrap justify-content-start">
					<div class="d-flex flex-wrap">
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400">Start Date</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.StartDate.ToString("f")</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400">End Date</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.EndDate.ToString("f")</div>
							</div>
						</div>
						<div class="border border-gray-300 border-dashed rounded min-w-125px py-3 px-4 me-6 mb-3">
							<div class="fw-semibold fs-6 text-gray-400">Sweepstakes</div>
							<div class="d-flex align-items-center">
								<div class="fs-4 fw-bold">@Model.Sweepstakes.Count()</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="separator"></div>
		<div class="card">
			<div class="card-header card-header-tabs">
				<div class="card-toolbar">
					<ul class="nav nav-stretch nav-line-tabs nav-line-tabs-2x border-transparent fs-5 fw-bold">
						<li class="nav-item">
							<a class="nav-link text-active-primary py-5 me-6 active" 
								data-bs-toggle="tab"
								href="#editDetails">
								Edit Details
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-active-primary py-5 me-6" 
								data-bs-toggle="tab"
								href="#sweepStakes">
								Sweepstakes
							</a>
						</li>
					</ul>
				</div>
			</div>
			<div class="card-body">
				<div class="tab-content" id="promotionsTabContent">
					<div class="tab-pane fade active show" id="editDetails" role="tabpanel">
						<form asp-action="Update" asp-controller="Promotions" asp-route-campaignUid="@Model.UpdatePromotion.CampaignUid">
							@Html.HiddenFor(m => m.UpdatePromotion.CampaignUid)
							<div class="card">
								<div class="card-body">
										<div class="fv-row mb-8">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Promotion Name
											</label>
											<input type="text" 
												class="form-control form-control-solid"
											   placeholder="@Model.UpdatePromotion.CampaignName"
											   value="@Model.UpdatePromotion.CampaignName"
											   asp-for="@Model.UpdatePromotion.CampaignName" />
										<span asp-validation-for="@Model.UpdatePromotion.CampaignName"></span>
										</div>
										<div class="fv-row mb-8">
											<label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Description
											</label>
											<textarea asp-for="@Model.UpdatePromotion.Description"
											class="form-control form-control-solid" rows="3">@Model.UpdatePromotion.Description</textarea>
											<span asp-validation-for="Description"></span>
										</div>
										<div class="fv-row mb-8">
											<label class="d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Promotion Type
											</label>
										<select asp-for="@Model.UpdatePromotion.CampaignTypeUid" asp-items=@Model.UpdatePromotion.CampaignTypes class="form-select form-control-lg">
												<option value="@Guid.Empty">Please select promotion type</option>
											</select>
										<span asp-validation-for="@Model.UpdatePromotion.CampaignTypeUid"></span>
										</div>
										<div class="fv-row mb-6 w-lg-250px">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												Start Date
											</label>
											<input class="form-control form-control-solid"
											   value="@Model.UpdatePromotion.StartDate.ToString("yyyy-MM-ddThh:mm:ss")"
											   asp-for="@Model.UpdatePromotion.StartDate"
													asp-format="{0:yyyy-MM-ddThh:mm:ss}" />
											<span asp-validation-for="StartDate"></span>
										</div>
										<div class="fv-row mb-6 w-lg-250px">
											<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
												End Date
											</label>
											<input class="form-control form-control-solid"
											   value="@Model.UpdatePromotion.EndDate.ToString("yyyy-MM-ddThh:mm:ss")"
											   asp-for="@Model.UpdatePromotion.EndDate"
												   asp-format="{0:yyyy-MM-ddThh:mm:ss}" />
											<span asp-validation-for="EndDate"></span>
										</div>
								</div>
								<div class="card-footer">
									<button type="submit" class="btn btn-lg btn-primary">Update</button>
								</div>
							</div>
						</form>
					</div>
					<div class="tab-pane fade show" id="sweepStakes" role="tabpanel">
						<table id="sweepStakesTable" 
							class="table table-row-bordered table-row-dashed gy-4 align-middle fw-bold">
							<thead class="fs-7 text-gray-400 text-uppercase">
								<tr>
									<th class="min-w-250px">Name</th>
									<th>Start Date</th>
									<th>End Date</th>
									<th>Draw Date</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody class="fs-6">
								@foreach(var item in Model.Sweepstakes)
								{
									<tr>
										<td>@item.Name</td>
										<td>@item.StartDate.ToString("f")</td>
										<td>@item.EndDate.ToString("f")</td>
										<td>@item.DrawDate.GetValueOrDefault().ToString("f")</td>
										<td>
											<div class="me-0">
												<button class="btn btn-sm btn-bg-light btn-active-color-primary" 
													data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
													<div>Actions</div>
												</button>
												<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
													<div class="menu-item px-3">
														<div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase">
															View Actions
														</div>
													</div>
													<div class="menu-item px-3">
														<a asp-action="View" asp-controller="Sweeps"
															asp-route-sweepUid="@item.SweepUid" class="menu-link px-3">
															Details
														</a>
													</div>
													<div class="menu-item px-3">
														<a asp-action="View" asp-controller="SweepRules" 
															asp-route-sweepUid="@item.SweepUid" class="menu-link flex-stack px-3">
															View Rules
														</a>
													</div>
													<div class="menu-item px-3">
														<a asp-action="View" asp-controller="SweepPrizes"
															asp-route-sweepUid="@item.SweepUid"
															asp-route-campaignUid=@Model.CampaignUid
															class="menu-link px-3">
															View Prizes
														</a>
													</div>
												</div>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
