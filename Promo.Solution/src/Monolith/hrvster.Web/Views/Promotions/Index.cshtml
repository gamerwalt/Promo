@using hrvster.Models.WebModels
@model IEnumerable<Promotion>
@{
    ViewData["Title"] = "Promotions";
}
<div class="card card-flush mt-6 mt-xl-9">
	<div class="card-header mt-5">
		<div class="card-title flex-column">
			<h3 class="fw-bold mb-1">Promotions</h3>
			<div class="fs-6 text-gray-400">@Model.Count() promotion(s) so far</div>
		</div>
		<div class="card-toolbar my-1">
			<div class="me-6 my-1">
				<a asp-action="Create" class="btn btn-sm btn-primary me-3">Add Promotion</a>
			</div>
		</div>
	</div>
	<div class="card-body pt-0">
		<div class="table-responsive">
			<table id="kt_profile_overview_table" class="table table-row-bordered table-row-dashed gy-4 align-middle fw-bold">
				<thead class="fs-7 text-gray-400 text-uppercase">
					<tr>
						<th class="min-w-250px">Name</th>
						<th class="min-w-150px">Start Date</th>
						<th class="min-w-90px">End Date</th>
						<th class="min-w-90px">Status</th>
						<th class="min-w-50px text-end">Details</th>
					</tr>
				</thead>
				<tbody class="fs-6">
					@foreach(var item in @Model)
					{
						<tr>
							<td>
								<div class="d-flex align-items-center">
									<div class="me-5 position-relative">
										<div class="symbol symbol-35px symbol-circle">
											<div class="symbol-label fs-2 fw-semibold text-success">@item.CampaignName[0]</div>
										</div>
									</div>
									<div class="d-flex flex-column justify-content-center">
										<a asp-action="View" asp-route-campaignUid=@item.CampaignUid
											class="fs-6 text-gray-800 text-hover-primary">@item.CampaignName</a>
										<div class="fs-8 fw-semibold text-gray-400">@item.PromotionType.CampaignTypeName</div>
									</div>
								</div>
							</td>
							<td>@item.StartDate.ToString("f")</td>
							<td>@item.EndDate.ToString("f")</td>
							<td>
								<span class="badge badge-light-@(@item.ActiveInd ? "success" : "danger") fw-bold px-4 py-3">
									@if(item.ActiveInd)
									{
										<span>Active</span>
									}
									else
									{
										<span>InActive</span>
									}
								</span>
							</td>
							<td class="text-end">
								<a asp-action="View" asp-route-campaignUid=@item.CampaignUid
									class="btn btn-light btn-sm">View</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>