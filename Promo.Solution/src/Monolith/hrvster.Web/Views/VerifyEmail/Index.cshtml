@model VerifyEmail
@{
    Layout = "~/Views/Shared/_AuthenticationLayout.cshtml";
    ViewData["Title"] = "Verify Account";
}
<div class="d-flex flex-column flex-root">
	<style>body { background-image: url('/assets/media/auth/bg4-dark.jpg'); }</style>
	<div class="d-flex flex-column flex-column-fluid flex-lg-row">
		<div class="d-flex flex-center w-lg-50 pt-15 pt-lg-0 px-10">
			<div class="d-flex flex-column">
				<a href="https://www.hrvster.com" class="mb-7">
					<img alt="Logo" src="~/images/hrvster_color_logo_no_background.png" height="100%" width="90%" />
				</a>
			</div>	
		</div>
		<div class="d-flex flex-center w-lg-50 p-10">
			<div class="card rounded-3 w-md-550px">
				<div class="card-body p-10 p-lg-20">
					<form class="form w-100" novalidate="novalidate" asp-controller="VerifyEmail" asp-action="Verify">
						<div class="text-center mb-10">
							<h1 class="text-dark fw-bolder mb-3">Verify Account</h1>
							<div class="text-gray-500 fw-semibold fs-6">Enter your email to verify your account.</div>
						</div>
						<div class="fv-row mb-8">
							<input type="text" asp-for="EmailAddress" placeholder="Email Address" autocomplete="off" class="form-control bg-transparent" />
						</div>
						<div class="d-flex flex-wrap justify-content-center pb-lg-0">
							<button type="submit" class="btn btn-primary me-4">
								<span class="indicator-label">Submit</span>
							</button>
							<a asp-controller="Session" asp-action="SignIn" class="btn btn-light">Cancel</a>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
