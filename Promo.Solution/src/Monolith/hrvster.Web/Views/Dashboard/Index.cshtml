@model Dashboard
@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex flex-wrap flex-stack my-5">
	<h2 class="fs-2 fw-semibold my-2">Promotions/Campaigns</h2>
</div>
<div id="kt_project_users_card_pane" class="tab-pane fade show active">
	<div class="row g-6 g-xl-9">
	@foreach(var campaign in @Model.Campaigns)
	{
		<div class="col-md-6 col-xxl-4">
			<div class="card">
				<div class="card-body d-flex flex-center flex-column pt-12 p-9">
					<div class="symbol symbol-65px symbol-circle mb-5">
						<div class="symbol-label fs-2 fw-semibold text-success">@campaign.CampaignName[0]</div>
					</div>
					<a asp-controller="Promotions" asp-action="View" asp-route-campaignUid=@campaign.CampaignUid
						class="fs-4 text-gray-800 text-hover-primary fw-bold mb-0">@campaign.CampaignName</a>
					<div class="fw-semibold text-gray-400 mb-6">@campaign.Description</div>
					<div class="d-flex flex-center flex-wrap">
						<a asp-controller="Promotions" asp-action="View" asp-route-campaignUid=@campaign.CampaignUid
							class="border border-gray-300 border-dashed rounded min-w-80px py-3 px-4 mx-2 mb-3 ">
							<div class="fs-6 fw-bold text-gray-700">@campaign.StartDate.ToString("f")</div>
							<div class="fw-semibold text-gray-400">Start Date</div>
						</a>
						<a asp-controller="Promotions" asp-action="View" asp-route-campaignUid=@campaign.CampaignUid
							class="border border-gray-300 border-dashed rounded min-w-80px py-3 px-4 mx-2 mb-3">
							<div class="fs-6 fw-bold text-gray-700 pulse">@campaign.EndDate.ToString("f")</div>
							<div class="fw-semibold text-gray-400">End Date</div>
						</a>
					</div>
				</div>
			</div>
		</div>
	}
	</div>
</div>
<div class="card mb-6 mb-xl-9 my-4">
	<div class="card-body pt-9 pb-0">
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			<div class="flex-grow-1">
				<div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
					<div class="d-flex flex-column">
						<div class="d-flex align-items-center mb-1">
							<form name="promotionForm" id="promotionForm">
								<select asp-items="@Model.Promotions" class="form-select">
									<option>Please select A Promotion</option>
								</select>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="separator my-5 mx-5"></div>
		<div id="sweepstakesTweetsLineChart"></div>
		<div class="separator my-5 mx-5"></div>
		<div id="sweepstakesEntriesLineChart"></div>
	</div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_DashboardsPartial");}
}
