@model Dashboard
@{
    ViewData["Title"] = "Dashboard";
}
<div class="card mb-6 mb-xl-9 my-4">
	<div class="card-body pt-9 pb-0">
		<div class="d-flex flex-wrap flex-sm-nowrap mb-6">
			<div class="flex-grow-1">
				<div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
					<div class="d-flex flex-column">
						<div class="d-flex align-items-center mb-1">
							<form name="promotionForm" id="promotionForm">
								<select asp-items="@Model.Promotions" class="form-select">
									<option>Please select A Promotion</option>
								</select>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="separator my-5 mx-5"></div>
		<div id="sweepstakesTweetsLineChart"></div>
		<div class="separator my-5 mx-5"></div>
		<div id="sweepstakesEntriesLineChart"></div>
	</div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_DashboardsPartial");}
}
