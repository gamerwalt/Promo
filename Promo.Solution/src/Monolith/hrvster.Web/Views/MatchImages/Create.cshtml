@model CreateImage
@{
	ViewData["Title"] = $"Create Image for {Model.MatchGame.Name}";
}
<div class="card card-bordered">
	<form asp-controller="MatchImages" asp-action="Create" enctype="multipart/form-data" class="form-horizontal form-material mx-2">
		<div class="card-body">
			<div class="d-flex flex-column flex-lg-row">
				<div class="flex-column flex-lg-row-auto w-100 w-lg-250px w-xxl-325px mb-8 mb-lg-0 me-lg-9 me-5">
					<div class="fv-row mb-8">
						<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
							Images
						</label>
						<input multiple asp-for="Images" class="form-control" placeholder="1" />
						<span asp-validation-for="Images"></span>
					</div>
				</div>
			</div>
		</div>
		<div class="card-footer">
			<div class="card-toolbar">
				<button type="submit" class="btn btn-md btn-light btn-primary">
					Create Image(s)
				</button>
			</div>
		</div>
	</form>
</div>