@model UpdateMatchImage
@{
	ViewData["Title"] = $"Update Image for {Model.MatchGame.Name}";
}
<div class="card card-bordered">
	<form asp-controller="MatchImages" asp-action="Update" enctype="multipart/form-data" class="form-horizontal form-material mx-2">
		<div class="card-body">
			<div class="d-flex flex-column flex-lg-row">
				<div class="flex-column flex-lg-row-auto w-100 w-lg-250px w-xxl-325px mb-8 mb-lg-0 me-lg-9 me-5">
					<div class="fv-row mb-8">
						<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
							Image
						</label>
						<input asp-for="Image" class="form-control" placeholder="1" />
						<span asp-validation-for="Image"></span>
					</div>
				</div>
			</div>
			<div class="flex-lg-row">
				<img class="mx-auto" width="124px" height="124px" src="@Model.MatchImage.LocationUrl" alt="MatchGameImage" />
			</div>
		</div>
		<div class="card-footer">
			<div class="card-toolbar">
				<button type="submit" class="btn btn-md btn-light btn-primary">
					Update Image
				</button>
			</div>
		</div>
	</form>
</div>