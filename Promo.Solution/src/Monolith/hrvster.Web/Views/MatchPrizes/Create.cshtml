@model CreateMatchPrize
@{
	ViewData["Title"] = $"Create Prize for {Model.MatchGameName}";
}
<div class="card card-bordered">
	<form 
		asp-controller="MatchPrizes" 
		asp-action="Create"
		asp-route-Uid="@Model.MatchGameUid"
		asp-route-actionName="@Model.ActionName"
		asp-route-controllerName=@Model.ControllerName
		class="form-horizontal form-material mx-2">
		<div class="card-body">
			<input asp-for="MatchGameUid" hidden />
			<div class="d-flex flex-column flex-lg-row">
				<div class="flex-lg-row-fluid me-lg-15 order-2 order-lg-1 mb-10 mb-lg-0">
					<div class="fv-row mb-8 w-lg-300px">
						<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
							Name
						</label>
						<input asp-for="Name" class="form-control" />
						<span asp-validation-for="Name"></span>
					</div>
					<div class="fv-row mb-8">
						<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
							Description
						</label>
						<input asp-for="Description" class="form-control" />
						<span asp-validation-for="Description"></span>
					</div>
					<div class="fv-row mb-8 w-lg-150px">
						<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
							Value
						</label>
						<input asp-for="Value" class="form-control" />
						<span asp-validation-for="Value"></span>
					</div>
					<div class="fv-row mb-8">
						<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
							Quantity (How many of this prizes are we giving out)
						</label>
						<input asp-for="Quantity" class="form-control w-lg-150px" />
						<span asp-validation-for="Quantity"></span>
					</div>
					<div class="fv-row mb-8">
						<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
							<input type="checkbox" asp-for="IsFiller" />
                            <span class="ms-2">Filler Prize</span>
						</label>
					</div>
					<div class="fv-row mb-8">
						<label class="required d-flex align-items-center fs-6 fw-semibold form-label mb-2">
							Select Image to associate with Prize
						</label>
						<input hidden asp-for=ImageUid class="form-control w-lg-150px" />
						<div id="image-container" class="d-flex flex-wrap">
							@foreach(var image in Model.MatchImages)
							{
								<div class="prize-image-box" data-uid="@image.Uid" style="background-image: url('@image.LocationUrl');"></div>
							}
						</div>
						<span asp-validation-for="Value"></span>
					</div>
				</div>
			</div>
		</div>
		<div class="card-footer">
			<div class="card-toolbar">
				<button type="submit" class="btn btn-md btn-light btn-primary">
					Create Prize
				</button>
			</div>
			<div class="card-body pt-0">
				<div class="table-responsive">
					<table id="kt_profile_overview_table" class="table table-row-bordered table-row-dashed gy-4 align-middle fw-bold">
						<thead class="fs-7 text-gray-400 text-uppercase">
							<tr>
								<th class="min-w-250px">Name</th>
								<th class="min-w-250px">Value</th>
								<th class="min-w-150px">Quantity</th>
							</tr>
						</thead>
						<tbody class="fs-7">
							@foreach (var prize in Model.Prizes)
							{
								<tr>
									<td>@prize.Name</td>
									<td>@prize.Value</td>
									<td>@prize.Quantity</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</form>
</div>