@model ErrorReason
@{
    ViewData["Title"] = "Error";
    Layout = "~/Views/Shared/_Error_Layout.cshtml";
}

<body class="error-page">
    <div class="exception-container">
        <h3>@Model.Message</h3>
        <img src="~/images/Error_Coffee.png" alt="Error Image" class="exception-image" />
    </div>
</body>