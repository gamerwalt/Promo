@model GameplayLoss
@{
    ViewData["Title"] = "You Lost";
}
<link rel="stylesheet" href="~/css/gameboard.css">
<link rel="stylesheet" href="~/css/gameplayloss.css">
<div class="game-wrapper">
    <h1 class="lose-message">You Lost</h1>
    <div class="gameboard">
        @foreach (var tile in Model.Tiles)
        {
            <div class="tile @((Model.SelectedTiles.Contains(tile.Uid)) ? "matched" : "")"
                    data-uid="@tile.Uid"
                    style="background-image: url('@tile.ImageUrl'); background-size: cover;">
            </div>
        }
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>