@using hrvster.Templates.Models.Layouts;
@model LayoutProperty
<style>
    .header {
        position: fixed;
        top: 0;
        width: 100%;
        height: 120px;
        z-index: 1000; /* To make sure the header is always on top */
    }

    .header-background {
        width: 100%;
        height: 100%;
    }

        .header-background img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .logo-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

        .logo-container img {
            height: 60px; /* adjust this to change the logo size */
            width: auto;
        }
</style>
<header class="header">
    <div class="header-background">
        <img src="@Model.HeaderLocation" alt="Header Image" />
    </div>
    <div class="logo-container">
        <img src="@Model.LogoLocation" alt="Logo Image" />
    </div>
</header>