@using hrvster.Core;
@using hrvster.Models;
@inject LinkBuilder linkBuilder

@model SweepEntry
@{
    var linkUrl = @linkBuilder.BuildTwitterLink(Model.Rule.ExternalId, Guid.Empty, Model.ScreenName).Result;
}
<link rel="stylesheet" href="~/css/site.css">
<div class="section-game">
    <div class="container">
        <div class="content-wrapper d-flex justify-content-center align-items-center flex-column vh-100">
            <div style="text-align: center">
                <h4 class="win-message text-center">
                    You have been entered into the sweepstake <strong>@Model.Sweep.Name</strong>
                </h4>
                <hr/>
                <h4 class="win-message text-center">
                    The sweepstake will run from <strong>@Model.Sweep.StartDateUtc.ToString("MMM d, yyyy hh:MM") GMT</strong> to <strong>@Model.Sweep.EndDateUtc.ToString("MMM d, yyyy hh:MM") GMT</strong>.
                </h4>
                <hr/>
                <h4 class="win-message text-center">
                    With a prize draw on <strong>@Model.Sweep.DrawDateUtc.ToString("MMM d, yyyy hh:MM") GMT</strong>
                </h4>
                <hr/>
                <h4 class="win-message text-center">
                    Winners will be automatically notified.
                </h4>
            </div>
        </div>
    </div>
</div>