@model PlaySweepsGame

<style>
    .form-container {
        max-width: 600px; /* Or whatever width you prefer */
    }
</style>
<div class="form-container mx-auto p-4">
    <div class="text-center mb-4">
        <h2>Enter The Sweepstake Game</h2>
    </div>
    <hr />
    <div class="text-center mb-2">
        <div>Welcome back <strong>@Model.FirstName @Model.LastName -- @Model.ScreenName</strong></div>
        <div>You have only <strong>@Model.NumberOfEntries</strong> entry you can have into this sweepstake at this time.</div>
        <div>Once you click on the <strong>Play</strong> button, you will be entered into the <strong>@Model.GameName</strong> Sweepstake</div>.
    </div>
    <form asp-action="Play" 
    asp-route-gameUid="@Model.GameUid" 
    asp-route-ruleUid="@Model.RuleUid" 
    asp-route-accountUid="@Model.AccountUid"
    asp-route-externalClient="@Model.ExternalClient"
    asp-route-campaignUid="@Model.CampaignUid"
    asp-route-handshakeKey="@Model.HandshakeKey" method="post">
        @Html.HiddenFor(x => x.GameName)
        @Html.HiddenFor(x => x.HandshakeKey);
        <div class="form-group text-center mt-2">
            <!-- Add text-center for alignment and mt-3 for margin top -->
            <button type="submit" class="btn btn-primary">Enter Sweepstake Now</button>
        </div>
    </form>
</div>