@model PlaySweepsGame

<link rel="stylesheet" href="~/css/site.css">
<div class="section-game">
    <div class="container">
        <div class="content-wrapper d-flex justify-content-center align-items-center flex-column vh-100">
            <div style="text-align: center">
                <h4 class="win-message text-center">
                    Welcome back <strong>@Model.ScreenName</strong>
                </h4>
            </div>
            <hr/>
            <div style="text-align: center">
                <h4 class="win-message text-center">
                    You have only <strong>@Model.NumberOfEntries</strong> <br>entry into this sweepstake at this time.
                </h4>
            </div>
            <hr/>
            <div style="text-align: center">
                <h4 class="win-message text-center">
                    Once you click on the <strong>Play</strong> button, <br/>you will be entered into the<br/><strong>@Model.GameName</strong> Sweepstake
                </h4>
            </div>
            <div style="text-align: center">
                <form asp-action="Play" 
                asp-route-gameUid="@Model.GameUid" 
                asp-route-ruleUid="@Model.RuleUid" 
                asp-route-accountUid="@Model.AccountUid"
                asp-route-externalClient="@Model.ExternalClient"
                asp-route-campaignUid="@Model.CampaignUid"
                asp-route-handshakeKey="@Model.HandshakeKey" method="post">
                    @Html.HiddenFor(x => x.GameName)
                    @Html.HiddenFor(x => x.HandshakeKey)
                    <div class="form-group text-center mt-2">
                        <!-- Add text-center for alignment and mt-3 for margin top -->
                        <button type="submit" class="btn btn-primary">Enter Sweepstake Now</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>