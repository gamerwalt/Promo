<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spin to Win</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
        body, html {
            height: 100%;
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .container {
            background: blue;
        }

        .pie {
            position: relative;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            overflow: hidden;
        }

            .pie div {
                background-size: contain;
                background-position: center;
                background-repeat: no-repeat;
                border: thin solid white;
                position: absolute;
                cursor: pointer;
                width: 100%;
                height: 100%;
                left: 50%;
                bottom: 50%;
                transform-origin: bottom left;
                transition: all 200ms ease-out;
            }

                .pie div:nth-child(1) {
                    transform: rotate(0deg) skewY(45deg);
                }

                .pie div:nth-child(2) {
                    transform: rotate(45deg) skewY(45deg);
                }

                .pie div:nth-child(3) {
                    transform: rotate(90deg) skewY(45deg);
                }

                .pie div:nth-child(4) {
                    transform: rotate(135deg) skewY(45deg);
                }

                .pie div:nth-child(5) {
                    transform: rotate(180deg) skewY(45deg);
                }

                .pie div:nth-child(6) {
                    transform: rotate(225deg) skewY(45deg);
                }

                .pie div:nth-child(7) {
                    transform: rotate(270deg) skewY(45deg);
                }

                .pie div:nth-child(8) {
                    transform: rotate(315deg) skewY(45deg);
                }

        #spinButton {
            margin-top: 3em;
            padding: 10px 20px;
            font-size: 18px;
        }
    </style>
</head>
<body>
    <div class="container d-flex flex-column justify-content-center align-items-center vh-100">
        <div class="needle"></div>
        <div class="pie">
            <div></div>
            <div></div>
            <div></div>
            <div></div>
            <div></div>
            <div></div>
            <div></div>
            <div></div>
        </div>
        <button id="spinButton" class="btn btn-primary">Spin</button>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
        document.getElementById('spinButton').addEventListener('click', function () {
            var pie = document.querySelector('.pie');
            var randomDegree = Math.floor(Math.random() * 3600 + 360); // Ensures at least one full spin
            pie.style.transition = 'transform 4s ease-out';
            pie.style.transform = 'rotate(' + randomDegree + 'deg)';
        });
    </script>
</body>
</html>