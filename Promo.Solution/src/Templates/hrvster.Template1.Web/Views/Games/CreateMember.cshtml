@model CreateMember

<style>
    .form-container {
        max-width: 600px; /* Or whatever width you prefer */
    }
</style>
<div class="form-container mx-auto p-4">
    <div class="text-center mb-4">
        <h2>Register</h2>
    </div>
    <form asp-action="CreateMember" asp-route-gameUid="@Model.GameUid" asp-route-ruleUid="@Model.RuleUid" asp-route-externalClient="@Model.ExternalClient" method="post">
        @Html.HiddenFor(x => x.GameName)
        <div class="form-group">
            <label asp-for="EmailAddress"></label>
            <input asp-for="EmailAddress" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="LastName"></label>
            <input asp-for="LastName" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Address1"></label>
            <input asp-for="Address1" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Address2"></label>
            <input asp-for="Address2" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="PhoneNumber"></label>
            <div class="row">
                <div class="col-sm-2">
                    <input type="text" class="form-control" value="+234" disabled />
                </div>
                <div class="col-sm-10">
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number" />
                </div>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="State"></label>
            <input asp-for="State" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="City"></label>
            <input asp-for="City" class="form-control" />
        </div>

        <div class="form-group text-center mt-3">
            <!-- Add text-center for alignment and mt-3 for margin top -->
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </form>
</div>