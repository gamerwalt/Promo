@model CreateMember
@{
    Layout = "_Layout";
}
<style>
    .form-container {
        max-width: 600px; /* Or whatever width you prefer */
    }

    .text-danger {
        color: red;
        font-weight: bold;
    }
</style>
<div class="form-container mx-auto p-4">
    <div class="text-center mb-4">
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">Register once to always have a chance to play again.</h4>
            <p>We just might send you a free gameboard to play.</p>
            <hr>
            <p class="mb-0"><h5><strong>Why are we collecting this information?</strong></h5></p>            
            <p>We are collecting this information so that when you eventually win, it is easy for us to contact you and award you your prize.</p>
            <p>We promise not to sell your information.</p>
            <p>This also helps us to prevent fraud.</p>
        </div>
    </div>
    <div class="text-center mb-4">
        
    </div>
    <form asp-action="CreateMember" 
        asp-route-gameUid="@Model.GameUid" 
        asp-route-ruleUid="@Model.RuleUid" 
        asp-route-externalClient="@Model.ExternalClient" 
        asp-route-gameType="@Model.GameType"
        method="post">
        @Html.HiddenFor(x => x.GameName)
        <div class="form-group">
            <label asp-for="EmailAddress">Email Address</label>
            <input asp-for="EmailAddress" class="form-control" />
            <span asp-validation-for="EmailAddress" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="FirstName">First Name</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName">Last Name</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="PhoneNumber"></label>
            <div class="row">
                <div class="col-sm-2">
                    <input type="text" class="form-control" value="+234" disabled />
                </div>
                <div class="col-sm-10">
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number" />
                </div>
            </div>
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="form-group text-center mt-3">
            <!-- Add text-center for alignment and mt-3 for margin top -->
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}